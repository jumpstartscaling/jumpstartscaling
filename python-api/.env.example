# God Mode API - Environment Template
# Copy to .env and fill in real values. Never commit .env.

# Database (PostgreSQL)
DATABASE_URL=postgresql://god_user:YOUR_PASSWORD@localhost:5432/god_mode
# Or individual vars:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=god_mode
# DB_USER=god_user
# DB_PASSWORD=your_password

# Server
PORT=8200
HOST=0.0.0.0

# Admin dashboard key (?key=... for /admin/leads)
ADMIN_KEY=spark

# Optional: disable request logging to api_logs
# LOG_REQUESTS=false
