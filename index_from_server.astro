---
import SEOTags from '../components/SEOTags.astro';
import GTMTracking from '../components/GTMTracking.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

const title = 'Jumpstart Scaling - Break Through The 7-Figure Ceiling';
const description = 'The proven methodology that helped 500+ founders automate operations, reclaim 20 hours a week, and build a valuation-ready asset in 90 days.';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <SEOTags title={title} description={description} />
    <SchemaOrg />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #FF6B35;
            --primary-dark: #E85A2A;
            --secondary: #4ECDC4;
            --dark: #050505;
            --dark-2: #0F0F12;
            --dark-3: #1A1A20;
            --text: #ffffff;
            --text-muted: #9CA3AF;
            --accent: #FFD93D;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--dark);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        /* Interactive Background */
        #canvas-container {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -1;
            opacity: 0.4;
            pointer-events: none;
        }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 2; }
        
        /* Typography & Utilities */
        h1, h2, h3 { line-height: 1.2; letter-spacing: -0.02em; }
        .highlight {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .text-center { text-align: center; }
        .mb-4 { margin-bottom: 1rem; }
        .mb-8 { margin-bottom: 2rem; }
        
        /* Hero Section */
        .hero {
            min-height: 90vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 4rem 0;
            background: radial-gradient(circle at center, rgba(255, 107, 53, 0.05) 0%, transparent 60%);
        }
        .hero h1 {
            font-size: clamp(2.5rem, 6vw, 5rem);
            font-weight: 900;
            margin-bottom: 2rem;
            max-width: 1000px;
            animation: fadeIn 1s ease-out;
        }
        .hero .subtitle {
            font-size: clamp(1.2rem, 3vw, 1.5rem);
            color: var(--text-muted);
            max-width: 800px;
            margin-bottom: 3rem;
            animation: fadeIn 1s ease-out 0.3s backwards;
        }
        .cta-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white; padding: 1.5rem 3.5rem; font-size: 1.25rem; font-weight: 700;
            border-radius: 50px; text-decoration: none; transition: all 0.3s ease;
            box-shadow: 0 10px 40px rgba(255, 107, 53, 0.3);
            display: inline-block;
            border: 2px solid rgba(255,255,255,0.1);
        }
        .cta-primary:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 20px 60px rgba(255, 107, 53, 0.5);
        }

        /* Pillars Section */
        .section { padding: 6rem 0; border-top: 1px solid rgba(255,255,255,0.05); }
        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2.5rem; }
        
        .card {
            background: rgba(26, 26, 32, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05);
            padding: 3rem;
            border-radius: 20px;
            transition: all 0.4s ease;
        }
        .card:hover {
            border-color: var(--primary);
            transform: translateY(-10px);
            background: rgba(26, 26, 32, 0.8);
        }
        .icon-large { font-size: 3rem; margin-bottom: 1.5rem; display: block; }
        
        /* Services List */
        .service-card {
            display: flex; flex-direction: column; height: 100%;
            border-top: 4px solid transparent;
        }
        .service-card:hover { border-top-color: var(--secondary); }
        .price { font-size: 2rem; font-weight: 800; color: white; margin: 1rem 0; }
        .price-sub { font-size: 1rem; color: var(--text-muted); font-weight: 500; }
        
        /* Survey Section */
        .survey-container {
            max-width: 800px; margin: 0 auto;
            background: rgba(26, 26, 32, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            padding: 4rem;
            border: 1px solid rgba(255, 107, 53, 0.2);
            box-shadow: 0 20px 80px -20px rgba(0,0,0,0.5);
        }
        .survey-question { font-size: 1.8rem; font-weight: 700; margin-bottom: 2rem; }
        
        /* Enhanced Survey Options */
        .options-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
        .option-card {
            position: relative;
            background: rgba(0,0,0,0.3);
            border: 2px solid rgba(255,255,255,0.1);
            padding: 1.5rem 2rem;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
        }
        .option-card:hover {
            border-color: var(--secondary);
            background: rgba(78, 205, 196, 0.05);
            transform: translateX(10px);
        }
        .option-card.selected {
            border-color: var(--primary);
            background: rgba(255, 107, 53, 0.1);
        }
        .option-card input {
            appearance: none;
            width: 24px; height: 24px;
            border: 2px solid var(--text-muted);
            border-radius: 50%;
            margin-right: 1.5rem;
            position: relative;
            transition: all 0.2s;
        }
        .option-card input:checked {
            border-color: var(--primary);
            background: var(--primary);
            box-shadow: 0 0 10px rgba(255, 107, 53, 0.4);
        }
        .option-text { font-size: 1.1rem; font-weight: 500; color: white; }
        
        /* Progress Bar */
        .progress-container {
            background: rgba(255,255,255,0.1); height: 6px; border-radius: 10px;
            margin-bottom: 3rem; overflow: hidden;
        }
        .progress-bar {
            height: 100%; background: linear-gradient(90deg, var(--primary), var(--secondary));
            width: 0%; transition: width 0.4s ease;
        }

        /* FAQ Section */
        .faq-item {
            background: var(--dark-3);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 12px;
            margin-bottom: 1rem;
            overflow: hidden;
            transition: all 0.3s;
        }
        .faq-question {
            padding: 1.5rem 2rem;
            font-weight: 600;
            font-size: 1.1rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .faq-question:after { content: '+'; font-size: 1.5rem; color: var(--primary); }
        .faq-item.active .faq-question:after { content: '-'; }
        .faq-answer {
            padding: 0 2rem;
            max-height: 0;
            overflow: hidden;
            color: var(--text-muted);
            transition: all 0.3s ease;
        }
        .faq-item.active .faq-answer { padding: 0 2rem 2rem; max-height: 500px; }

        /* Animation */
        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        @media(max-width: 768px) {
            .survey-container { padding: 2rem; }
            .hero h1 { font-size: 2.5rem; }
        }
    </style>
</head>
<body>
    <!-- Interactive Background Canvas -->
    <canvas id="canvas-container"></canvas>

    <!-- Hero -->
    <section class="hero">
        <div class="container">
            <span class="mb-4" style="display:inline-block; padding: 0.5rem 1.5rem; background: rgba(255,107,53,0.1); color: var(--primary); border-radius: 50px; font-weight: 600; font-size: 0.9rem;">
                FOR FOUNDERS & AGENCY OWNERS
            </span>
            <h1>
                Scale From 7 to 8 Figures<br>
                <span class="highlight">Without The Burnout</span>
            </h1>
            <p class="subtitle">
                The Jumpstart Methodology: Automate operations, install self-managing teams, 
                and build a valuation-ready asset in 90 days or less.
            </p>
            <a href="#survey" class="cta-primary">
                Get Your Free Scaling Blueprint
            </a>
            <p style="margin-top: 1rem; color: var(--text-muted); font-size: 0.9rem;">No credit card required • Personalized Roadmap</p>
        </div>
    </section>

    <!-- The Problem (Blocks of Text for SEO) -->
    <section class="section">
        <div class="container">
            <div style="max-width: 900px; margin: 0 auto;">
                <h2 class="section-title text-center mb-8" style="font-size: 2.5rem;">Why Success Feels Like a Trap</h2>
                <div class="card" style="margin-bottom: 2rem;">
                    <h3 style="color: var(--primary); margin-bottom: 1rem;">The "Chief Everything Officer" Problem</h3>
                    <p style="color: #ccc; margin-bottom: 1rem;">
                        Most founders reach $1M-$3M in revenue through sheer force of will. You are the best salesperson, the best project manager, and the final quality check. This works—until it doesn't. 
                    </p>
                    <p style="color: #ccc;">
                        As you scale, the complexity of your business outpaces your personal capacity. You become the bottleneck. Every new client adds stress, not freedom. This is the "Scaling Trap."
                    </p>
                </div>
                <div class="grid-3">
                    <div class="card">
                        <h3>❌ The Golden Handcuffs</h3>
                        <p style="color: var(--text-muted); margin-top: 0.5rem;">You make good money, but you can't leave for a week without things breaking.</p>
                    </div>
                    <div class="card">
                        <h3>❌ Profit Compression</h3>
                        <p style="color: var(--text-muted); margin-top: 0.5rem;">You hire more people to help, but efficiency drops and margins get thinner.</p>
                    </div>
                    <div class="card">
                        <h3>❌ The Plateau</h3>
                        <p style="color: var(--text-muted); margin-top: 0.5rem;">You've been stuck at the same revenue level for 12+ months despite working harder.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services -->
    <section class="section" style="background: rgba(255,255,255,0.02);">
        <div class="container">
            <h2 class="text-center mb-4" style="font-size: 2.5rem;">Done-For-You Scaling Services</h2>
            <p class="text-center mb-8" style="color: var(--text-muted);">Select the exact component you need to fix your bottleneck.</p>
            
            <div class="grid-3" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));">
                <!-- Card 1 -->
                <div class="card service-card">
                    <h3>Paid Acquisition</h3>
                    <p class="price">$2,250<span class="price-sub">/mo</span></p>
                    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Daily optimization of your ad spend to drive consistent leads.</p>
                    <ul style="color: #ccc; list-style: none; line-height: 2;">
                        <li>✓ Daily Ads Management</li>
                        <li>✓ Creative Testing</li>
                        <li>✓ ROI Reporting</li>
                    </ul>
                </div>
                <!-- Card 2 -->
                <div class="card service-card">
                    <h3>Funnel Architecture</h3>
                    <p class="price">$3,500<span class="price-sub">/project</span></p>
                    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">High-converting sales funnels built to capture and nurture leads automatically.</p>
                    <ul style="color: #ccc; list-style: none; line-height: 2;">
                        <li>✓ Copywriting & Design</li>
                        <li>✓ Technical Integration</li>
                        <li>✓ A/B Testing Setup</li>
                    </ul>
                </div>
                <!-- Card 3 -->
                <div class="card service-card" style="border-color: var(--primary);">
                    <h3 style="color: var(--primary);">Full Scaling Retainer</h3>
                    <p class="price">$5,200<span class="price-sub">/week</span></p>
                    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Complete "Head of Growth" replacement. We run everything.</p>
                    <ul style="color: #ccc; list-style: none; line-height: 2;">
                        <li>✓ Unlimited Projects</li>
                        <li>✓ Dedicated Growth Team</li>
                        <li>✓ Weekly Strategy Calls</li>
                    </ul>
                </div>
                <!-- Card 4 -->
                <div class="card service-card">
                    <h3>CRM Automation</h3>
                    <p class="price">$2,500<span class="price-sub">/setup</span></p>
                    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Turn chaos into clarity with a fully automated lead tracking system.</p>
                    <ul style="color: #ccc; list-style: none; line-height: 2;">
                        <li>✓ Custom Pipelines</li>
                        <li>✓ Auto-Follow Up</li>
                        <li>✓ Dashboard Setup</li>
                    </ul>
                </div>
                <!-- Card 5 -->
                <div class="card service-card">
                    <h3>Data & Analytics</h3>
                    <p class="price">$1,500<span class="price-sub">/mo</span></p>
                    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Know exactly which dollar drives profit with server-side tracking.</p>
                    <ul style="color: #ccc; list-style: none; line-height: 2;">
                        <li>✓ Server-Side Tracking</li>
                        <li>✓ Attribution Modeling</li>
                        <li>✓ Live Dashboards</li>
                    </ul>
                </div>
                <!-- Card 6 -->
                <div class="card service-card">
                    <h3>Content Engine</h3>
                    <p class="price">$4,000<span class="price-sub">/mo</span></p>
                    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Build an omnipresent brand that attracts top-tier clients.</p>
                    <ul style="color: #ccc; list-style: none; line-height: 2;">
                        <li>✓ LinkedIn Growth</li>
                        <li>✓ Newsletter Ops</li>
                        <li>✓ Video Editing</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Survey Section -->
    <section class="section" id="survey">
        <div class="container">
            <div class="survey-container">
                <div class="text-center mb-8">
                    <h2 style="font-size: 2.2rem; margin-bottom: 1rem;">Claim Your Scaling Blueprint</h2>
                    <p style="color: var(--text-muted);">Answer 7 questions to generate your custom 90-day growth roadmap.</p>
                </div>

                <div class="progress-container">
                    <div class="progress-bar" id="progressFill"></div>
                </div>

                <form id="surveyForm">
                    <!-- Step 1 -->
                    <div class="form-step active" data-step="1">
                        <div class="survey-question">1. What is your #1 bottleneck right now?</div>
                        <div class="options-grid">
                            <label class="option-card">
                                <input type="radio" name="challenge" value="leads" required>
                                <span class="option-text">Generating consistent qualified leads</span>
                            </label>
                            <label class="option-card">
                                <input type="radio" name="challenge" value="delivery">
                                <span class="option-text">Operations break when I step away</span>
                            </label>
                            <label class="option-card">
                                <input type="radio" name="challenge" value="hiring">
                                <span class="option-text">Finding and keeping 'A-Players'</span>
                            </label>
                            <label class="option-card">
                                <input type="radio" name="challenge" value="time">
                                <span class="option-text">I'm working 60+ hours a week</span>
                            </label>
                        </div>
                        <div class="mt-8 text-right" style="margin-top: 2rem; display: flex; justify-content: flex-end;">
                            <button type="button" class="cta-primary" style="padding: 1rem 3rem; border: none; cursor: pointer;" onclick="nextStep()">Next 👉</button>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="form-step" data-step="2" style="display:none;">
                        <div class="survey-question">2. Annual Revenue Range</div>
                        <div class="options-grid">
                            <label class="option-card"><input type="radio" name="revenue" value="250k-500k"><span class="option-text">$250k - $500k</span></label>
                            <label class="option-card"><input type="radio" name="revenue" value="500k-1m"><span class="option-text">$500k - $1M</span></label>
                            <label class="option-card"><input type="radio" name="revenue" value="1m-3m"><span class="option-text">$1M - $3M</span></label>
                            <label class="option-card"><input type="radio" name="revenue" value="3m+"><span class="option-text">$3M+</span></label>
                        </div>
                        <div class="mt-8" style="margin-top: 2rem; display: flex; justify-content: space-between;">
                            <button type="button" class="card" style="padding: 1rem 2rem; color: white;" onclick="prevStep()">Back</button>
                            <button type="button" class="cta-primary" style="padding: 1rem 3rem; border: none; cursor: pointer;" onclick="nextStep()">Next 👉</button>
                        </div>
                    </div>

                    <!-- Step 3 (Services) -->
                    <div class="form-step" data-step="3" style="display:none;">
                        <div class="survey-question">3. Which services interest you?</div>
                        <div class="options-grid">
                            <label class="option-card"><input type="checkbox" name="services" value="ads"><span class="option-text">Paid Ads Management</span></label>
                            <label class="option-card"><input type="checkbox" name="services" value="funnels"><span class="option-text">Funnels & Web Design</span></label>
                            <label class="option-card"><input type="checkbox" name="services" value="automation"><span class="option-text">CRM & Automation</span></label>
                            <label class="option-card"><input type="checkbox" name="services" value="full"><span class="option-text">Full Growth Retainer</span></label>
                        </div>
                        <div class="mt-8" style="margin-top: 2rem; display: flex; justify-content: space-between;">
                            <button type="button" class="card" style="padding: 1rem 2rem; color: white;" onclick="prevStep()">Back</button>
                            <button type="button" class="cta-primary" style="padding: 1rem 3rem; border: none; cursor: pointer;" onclick="nextStep()">Next 👉</button>
                        </div>
                    </div>

                    <!-- Step 4 (Contact) -->
                    <div class="form-step" data-step="4" style="display:none;">
                        <div class="survey-question">4. Where should we send your Blueprint?</div>
                        <div style="display: grid; gap: 1.5rem;">
                            <input type="text" name="name" placeholder="Your Full Name" style="width: 100%; padding: 1.2rem; background: rgba(0,0,0,0.3); border: 2px solid rgba(255,255,255,0.1); border-radius: 8px; color: white; font-size: 1.1rem;">
                            <input type="email" name="email" placeholder="Work Email Address" style="width: 100%; padding: 1.2rem; background: rgba(0,0,0,0.3); border: 2px solid rgba(255,255,255,0.1); border-radius: 8px; color: white; font-size: 1.1rem;">
                            <input type="tel" name="phone" placeholder="Mobile Number (for SMS updates)" style="width: 100%; padding: 1.2rem; background: rgba(0,0,0,0.3); border: 2px solid rgba(255,255,255,0.1); border-radius: 8px; color: white; font-size: 1.1rem;">
                        </div>
                        <div class="mt-8" style="margin-top: 2rem; display: flex; justify-content: space-between;">
                            <button type="button" class="card" style="padding: 1rem 2rem; color: white;" onclick="prevStep()">Back</button>
                            <button type="submit" class="cta-primary" style="padding: 1rem 3rem; border: none; cursor: pointer;">Complete Application 🚀</button>
                        </div>
                    </div>
                </form>

                 <div class="success-message" id="successMessage" style="display:none; text-align: center;">
                    <div style="font-size: 5rem; margin-bottom: 2rem;">🎉</div>
                    <h2 style="margin-bottom: 1rem;">Application Received!</h2>
                    <p>Our team is reviewing your profile. Expect a text message from us within 2 hours.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section for SEO -->
    <section class="section">
        <div class="container" style="max-width: 800px;">
            <h2 class="text-center mb-8">Frequently Asked Questions</h2>
            <div class="faq-item">
                <div class="faq-question">Who is Jumpstart Scaling for?</div>
                <div class="faq-answer">
                    Jumpstart Scaling is specifically designed for B2B Agency Owners, SaaS Founders, and Consultants who are generating at least $250k/year and are ready to scale to $1M+. It is not for complete beginners or e-commerce dropshippers.
                </div>
            </div>
             <div class="faq-item">
                <div class="faq-question">Do you offer a guarantee?</div>
                <div class="faq-answer">
                    Yes. We work on a performance basis for qualified partners. If we don't hit the agreed-upon KPIs for your scaling roadmap, we work for free until we do.
                </div>
            </div>
             <div class="faq-item">
                <div class="faq-question">How fast can I see results?</div>
                <div class="faq-answer">
                    Our "quick wins" protocol typically frees up 10 hours of founder time in the first 14 days. Revenue impact usually begins around day 30-45 as the new acquisition systems gain traction.
                </div>
            </div>
        </div>
    </section>

    <footer style="padding: 4rem 0; border-top: 1px solid rgba(255,255,255,0.1); text-align: center; color: var(--text-muted);">
        <p>&copy; 2026 Jumpstart Scaling. All Rights Reserved.</p>
        <div style="margin-top: 1rem;">
            <a href="#" style="color: var(--text-muted); margin: 0 1rem;">Privacy Policy</a>
            <a href="#" style="color: var(--text-muted); margin: 0 1rem;">Terms</a>
        </div>
    </footer>

    <!-- Interactive Background Script -->
    <script is:inline>
        const canvas = document.getElementById('canvas-container');
        const ctx = canvas.getContext('2d');
        let width, height;
        let particles = [];
        
        // Configuration
        const particleCount = 60;
        const connectionDistance = 150;
        const mouseDistance = 200;

        function resize() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }

        class Particle {
            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.vx = (Math.random() - 0.5) * 0.5;
                this.vy = (Math.random() - 0.5) * 0.5;
                this.size = Math.random() * 2 + 1;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;

                if (this.x < 0 || this.x > width) this.vx *= -1;
                if (this.y < 0 || this.y > height) this.vy *= -1;
            }

            draw() {
                ctx.fillStyle = 'rgba(255, 107, 53, 0.5)';
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        let mouse = { x: null, y: null };
        window.addEventListener('mousemove', (e) => {
            mouse.x = e.x;
            mouse.y = e.y;
        });

        function init() {
            resize();
            for (let i = 0; i < particleCount; i++) {
                particles.push(new Particle());
            }
        }

        function animate() {
            ctx.clearRect(0, 0, width, height);
            
            particles.forEach((p, index) => {
                p.update();
                p.draw();
                
                // Connect particles
                for (let j = index + 1; j < particles.length; j++) {
                    const p2 = particles[j];
                    const dx = p.x - p2.x;
                    const dy = p.y - p2.y;
                    const distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < connectionDistance) {
                        ctx.strokeStyle = `rgba(255, 107, 53, ${1 - distance/connectionDistance * 0.5})`;
                        ctx.lineWidth = 1;
                        ctx.beginPath();
                        ctx.moveTo(p.x, p.y);
                        ctx.lineTo(p2.x, p2.y);
                        ctx.stroke();
                    }
                }

                // Connect to mouse
                if (mouse.x) {
                    const dx = p.x - mouse.x;
                    const dy = p.y - mouse.y;
                    const distance = Math.sqrt(dx * dx + dy * dy);
                    if (distance < mouseDistance) {
                        ctx.strokeStyle = `rgba(78, 205, 196, ${1 - distance/mouseDistance})`;
                        ctx.beginPath();
                        ctx.moveTo(p.x, p.y);
                        ctx.lineTo(mouse.x, mouse.y);
                        ctx.stroke();
                    }
                }
            });
            
            requestAnimationFrame(animate);
        }

        window.addEventListener('resize', resize);
        init();
        animate();

        // FAQ Toggle
        document.querySelectorAll('.faq-question').forEach(item => {
            item.addEventListener('click', () => {
                item.parentElement.classList.toggle('active');
            });
        });

        // Survey Logic (Simulated)
        let currentStep = 1;
        window.nextStep = function() {
            document.querySelector(`.form-step[data-step="${currentStep}"]`).style.display = 'none';
            currentStep++;
            document.querySelector(`.form-step[data-step="${currentStep}"]`).style.display = 'block';
            document.getElementById('progressFill').style.width = (currentStep / 4 * 100) + '%';
        }
        window.prevStep = function() {
            document.querySelector(`.form-step[data-step="${currentStep}"]`).style.display = 'none';
            currentStep--;
            document.querySelector(`.form-step[data-step="${currentStep}"]`).style.display = 'block';
            document.getElementById('progressFill').style.width = (currentStep / 4 * 100) + '%';
        }

        // Add selection highlight logic
        document.querySelectorAll('.option-card input').forEach(input => {
            input.addEventListener('change', function() {
                // Clear siblings if radio
                if(this.type === 'radio') {
                    this.closest('.options-grid').querySelectorAll('.option-card').forEach(c => c.classList.remove('selected'));
                }
                if(this.checked) {
                    this.parentElement.classList.add('selected');
                } else {
                    this.parentElement.classList.remove('selected');
                }
            });
        });
        
        document.getElementById('surveyForm').addEventListener('submit', (e) => {
            e.preventDefault();
            document.querySelector('#surveyForm').style.display = 'none';
            document.querySelector('#successMessage').style.display = 'block';
             // Webhook logic here
             const n8nWebhookUrl = 'https://n8n.jumpstartscaling.com/webhook/YOUR_UNIQUE_WEBHOOK_ID'; // Placeholder
             if(n8nWebhookUrl && !n8nWebhookUrl.includes('YOUR_UNIQUE_WEBHOOK_ID')) {
                 const formData = new FormData(e.target);
                 fetch(n8nWebhookUrl, { method: 'POST', body: formData });
             }
        });
    </script>
    <GTMTracking />
</body>
</html>
