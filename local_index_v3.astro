---
const title = 'Jumpstart Scaling - Break Through The 7-Figure Ceiling';
const description = 'The proven methodology that helped 500+ founders automate operations, reclaim 20 hours a week, and build a valuation-ready asset in 90 days.';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #FF6B35;
            --primary-dark: #E85A2A;
            --secondary: #4ECDC4;
            --dark: #050505;
            --dark-2: #0F0F12;
            --dark-3: #1A1A20;
            --text: #ffffff;
            --text-muted: #9CA3AF;
            --accent: #FFD93D;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--dark);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }
        


        .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 2; }
        
        h1, h2, h3 { line-height: 1.2; letter-spacing: -0.02em; }
        .highlight {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .code-font { font-family: 'JetBrains Mono', monospace; }
        
        .hero {
            min-height: 90vh;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            text-align: center; padding: 4rem 0;
            background: radial-gradient(circle at center, rgba(255, 107, 53, 0.05) 0%, transparent 60%);
        }
        .hero h1 { font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 900; margin-bottom: 2rem; max-width: 1000px; animation: fadeIn 1s ease-out; }
        .hero .subtitle { font-size: clamp(1.2rem, 3vw, 1.5rem); color: var(--text-muted); max-width: 800px; margin-bottom: 3rem; animation: fadeIn 1s ease-out 0.3s backwards; }
        
        .cta-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white; padding: 1.5rem 3.5rem; font-size: 1.25rem; font-weight: 700;
            border-radius: 50px; text-decoration: none; transition: all 0.3s ease;
            box-shadow: 0 10px 40px rgba(255, 107, 53, 0.3); display: inline-block;
            border: 2px solid rgba(255,255,255,0.1); cursor: pointer;
        }
        .cta-primary:hover { transform: translateY(-5px) scale(1.02); box-shadow: 0 20px 60px rgba(255, 107, 53, 0.5); }

        .feature-section {
            padding: 8rem 0;
            border-top: 1px solid rgba(255,255,255,0.05);
            position: relative;
            overflow: hidden;
        }
        .feature-section:nth-child(even) { background: var(--dark-2); }
        
        .feature-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;
        }
        .feature-section:nth-child(odd) .feature-grid .feature-content { order: 1; }
        .feature-section:nth-child(odd) .feature-grid .feature-visual { order: 2; }
        .feature-section:nth-child(even) .feature-grid .feature-content { order: 2; }
        .feature-section:nth-child(even) .feature-grid .feature-visual { order: 1; }

        .feature-content h2 { font-size: 3rem; margin-bottom: 1.5rem; }
        .feature-price { font-size: 1.5rem; color: var(--primary); font-family: 'JetBrains Mono', monospace; margin-bottom: 1.5rem; display: block; }
        .feature-desc { font-size: 1.1rem; color: #ccc; margin-bottom: 2rem; line-height: 1.8; }
        .feature-list { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .feature-list li { display: flex; align-items: center; color: var(--text-muted); }
        .feature-list li:before { content: '→'; color: var(--secondary); margin-right: 10px; font-weight: bold; }

        .feature-visual {
            background: linear-gradient(135deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px;
            padding: 2rem;
            position: relative;
            min-height: 400px;
            display: flex; align-items: center; justify-content: center;
            opacity: 0; transform: translateY(30px); transition: all 0.8s ease-out;
        }
        .feature-visual.visible { opacity: 1; transform: translateY(0); }
        
        .code-window {
            background: #1e1e1e; border-radius: 8px; box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            width: 100%; font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; overflow: hidden;
            border: 1px solid #333;
        }
        .window-header {
            background: #252526; padding: 10px 15px; display: flex; gap: 8px; border-bottom: 1px solid #333;
        }
        .dot { width: 12px; height: 12px; border-radius: 50%; }
        .red { background: #ff5f56; } .yellow { background: #ffbd2e; } .green { background: #27c93f; }
        .window-body { padding: 20px; color: #d4d4d4; line-height: 1.6; }
        .k { color: #569cd6; } .s { color: #ce9178; } .f { color: #dcdcaa; } .c { color: #6a9955; } .n { color: #b5cea8; }

        .survey-section { padding: 6rem 0; margin-top: 4rem; }
        .survey-container {
            max-width: 800px; margin: 0 auto;
            background: rgba(26, 26, 32, 0.8); backdrop-filter: blur(20px);
            border-radius: 24px; padding: 4rem;
            border: 1px solid rgba(255, 107, 53, 0.2);
            box-shadow: 0 20px 80px -20px rgba(0,0,0,0.5);
        }
        
        .options-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
        .option-card {
            position: relative; background: rgba(0,0,0,0.3); border: 2px solid rgba(255,255,255,0.1);
            padding: 1.5rem 2rem; border-radius: 12px; cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); display: flex; align-items: center;
        }
        .option-card:hover { border-color: var(--secondary); background: rgba(78, 205, 196, 0.05); transform: translateX(10px); }
        .option-card.selected { border-color: var(--primary); background: rgba(255, 107, 53, 0.1); }
        .option-card input { appearance: none; width: 24px; height: 24px; border: 2px solid var(--text-muted); border-radius: 50%; margin-right: 1.5rem; }
        .option-card input:checked { border-color: var(--primary); background: var(--primary); }
        .option-text { font-size: 1.2rem; font-weight: 600; }

        .faq-item {
            background: var(--dark-3); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px;
            margin-bottom: 1rem; overflow: hidden;
        }
        .faq-question { padding: 1.5rem 2rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; }
        .faq-answer { padding: 0 2rem; max-height: 0; overflow: hidden; transition: all 0.3s ease; color: var(--text-muted); }
        .faq-item.active .faq-answer { padding: 0 2rem 2rem; max-height: 500px; }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @media(max-width: 900px) {
            .feature-grid { grid-template-columns: 1fr !important; }
            .feature-visual { order: 1 !important; margin-bottom: 2rem; min-height: 300px; }
            .feature-content { order: 2 !important; }
            h2 { font-size: 2rem; }
        }
    </style>
</head>
<body>
    <canvas id="canvas-container" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; opacity: 0.3; pointer-events: none;"></canvas>

    <section class="hero">
        <div class="container">
            <span style="display:inline-block; padding: 0.5rem 1.5rem; background: rgba(255,107,53,0.1); color: var(--primary); border-radius: 50px; font-weight: 600; font-size: 0.9rem; margin-bottom: 1.5rem;">
                FOR 7-FIGURE FOUNDERS
            </span>
            <h1>Scale Without The <span class="highlight">Burnout</span></h1>
            <p class="subtitle">The Jumpstart Methodology: Automate operations, install self-managing teams, and build a valuation-ready asset in 90 days.</p>
            <a href="#survey" class="cta-primary">Get Your Scaling Blueprint</a>
        </div>
    </section>

    <!-- 1. Paid Acquisition -->
    <section class="feature-section">
        <div class="container feature-grid">
            <div class="feature-content">
                <h2>Paid Acquisition Engine</h2>
                <span class="feature-price">$2,250 / month</span>
                <p class="feature-desc">Stop relying on referrals. We build a predictable machine that turns $1 into $5. Includes daily ad management, creative testing, and multi-channel orchestration.</p>
                <ul class="feature-list">
                    <li>Daily Optimization</li>
                    <li>Creative Refresh</li>
                    <li>Cross-Platform Scale</li>
                    <li>ROI Dashboard</li>
                </ul>
            </div>
            <div class="feature-visual">
                <div class="code-window">
                    <div class="window-header"><div class="dot red"></div><div class="dot yellow"></div><div class="dot green"></div></div>
                    <div class="window-body">
                        <span class="k">class</span> AcquisitionEngine:<br>
                        &nbsp;&nbsp;<span class="k">def</span> <span class="f">optimize_spend</span>(self):<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;<span class="c"># Auto-scale winning ads</span><br>
                        &nbsp;&nbsp;&nbsp;&nbsp;<span class="k">if</span> self.roas > <span class="n">4.0</span>:<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;self.<span class="f">scale_budget</span>(factor=<span class="n">1.5</span>)<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return <span class="s">"Scaling Profitable Campagins"</span><br>
                        &nbsp;&nbsp;&nbsp;&nbsp;<span class="k">else</span>:<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;self.<span class="f">kill_underperformers</span>()
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Funnel Architecture -->
    <section class="feature-section">
        <div class="container feature-grid">
            <div class="feature-content">
                <h2>Funnel Architecture</h2>
                <span class="feature-price">$3,500 / project</span>
                <p class="feature-desc">Traffic is useless without conversion. We design and build high-converting sales funnels that qualify leads automatically, saving your sales team hours every day.</p>
                <ul class="feature-list">
                    <li>Conversion Copywriting</li>
                    <li>UX/UI Design</li>
                    <li>Tech Integration</li>
                    <li>A/B Testing</li>
                </ul>
            </div>
            <div class="feature-visual">
                <div style="text-align: center; width: 100%;">
                    <div style="background: var(--dark-3); padding: 1rem; margin: 10px auto; width: 80%; border-radius: 8px; border: 1px solid #333;">Ad Click</div>
                    <div style="font-size: 1.5rem; color: var(--secondary);">↓</div>
                    <div style="background: var(--dark-3); padding: 1rem; margin: 10px auto; width: 60%; border-radius: 8px; border: 1px solid var(--secondary);">Landing Page (25% Conv)</div>
                    <div style="font-size: 1.5rem; color: var(--secondary);">↓</div>
                    <div style="background: var(--dark-3); padding: 1rem; margin: 10px auto; width: 40%; border-radius: 8px; border: 1px solid var(--primary);">Booking Confirmed ($$)</div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. CRM Automation -->
    <section class="feature-section">
        <div class="container feature-grid">
            <div class="feature-content">
                <h2>CRM Transformation</h2>
                <span class="feature-price">$2,500 / setup</span>
                <p class="feature-desc">We turn your CRM into a self-driving car. From lead intake to contract signature, we automate the manual admin work that slows your team down.</p>
                <ul class="feature-list">
                    <li>Custom Pipelines</li>
                    <li>Auto-Follow Up SMS/Email</li>
                    <li>Contract Automation</li>
                    <li>Lead Scoring</li>
                </ul>
            </div>
            <div class="feature-visual">
                <div class="code-window">
                    <div class="window-header"><div class="dot red"></div><div class="dot yellow"></div><div class="dot green"></div></div>
                    <div class="window-body">
                        <span class="c">// Triggers when new lead arrives</span><br>
                        <span class="k">async function</span> <span class="f">handleLead</span>(lead) {<br>
                        &nbsp;&nbsp;<span class="k">await</span> crm.<span class="f">createContact</span>(lead);<br>
                        &nbsp;&nbsp;<span class="k">await</span> sms.<span class="f">send</span>(lead.phone, <span class="s">"Hey! Ready to scale?"</span>);<br>
                        &nbsp;&nbsp;<span class="k">await</span> slack.<span class="f">notifyTeam</span>(<span class="s">"🔥 Hot Lead Incoming!"</span>);<br>
                        &nbsp;&nbsp;return <span class="s">"Automated Sequence Started"</span>;<br>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- 4. Data & Analytics -->
    <section class="feature-section">
        <div class="container feature-grid">
            <div class="feature-content">
                <h2>Data & Attribution</h2>
                <span class="feature-price">$1,500 / month</span>
                <p class="feature-desc">Fly blind, and you'll crash. We implement server-side tracking and multi-touch attribution so you know exactly which dollar is generating profit.</p>
                <ul class="feature-list">
                    <li>Server-Side Tracking</li>
                    <li>Attribution Modeling</li>
                    <li>Live Looker Studio Dash</li>
                    <li>Conversion API</li>
                </ul>
            </div>
            <div class="feature-visual">
                 <svg width="300" height="200" viewBox="0 0 300 200">
                    <path d="M10,180 Q50,150 100,160 T290,20" fill="none" stroke="var(--primary)" stroke-width="3"/>
                    <path d="M10,180 Q50,170 100,140 T290,80" fill="none" stroke="var(--secondary)" stroke-width="3" stroke-dasharray="5,5"/>
                    <circle cx="100" cy="160" r="4" fill="white"/>
                    <circle cx="290" cy="20" r="6" fill="var(--primary)"/>
                    <text x="220" y="200" fill="#fff" font-family="monospace">ROI: +420%</text>
                 </svg>
            </div>
        </div>
    </section>

    <!-- 5. Content Engine -->
    <section class="feature-section">
        <div class="container feature-grid">
            <div class="feature-content">
                <h2>The Authority Engine</h2>
                <span class="feature-price">$4,000 / month</span>
                <p class="feature-desc">Become the category King. We not only produce content but distribute it to build an omnipresent brand presence that attracts top-tier clients.</p>
                <ul class="feature-list">
                    <li>LinkedIn Growth</li>
                    <li>Newsletter Ops</li>
                    <li>Video Editing</li>
                    <li>Asset Distribution</li>
                </ul>
            </div>
             <div class="feature-visual">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%;">
                    <div style="background: #333; height: 100px; border-radius: 8px;"></div>
                    <div style="background: #2a2a2a; height: 100px; border-radius: 8px;"></div>
                    <div style="background: #2a2a2a; height: 100px; border-radius: 8px;"></div>
                    <div style="background: #333; height: 100px; border-radius: 8px;"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- 6. Full Retainer -->
    <section class="feature-section" style="background: radial-gradient(circle at center, rgba(255,107,53,0.1) 0%, #050505 100%); border-top: 1px solid var(--primary);">
        <div class="container feature-grid">
            <div class="feature-content">
                <h2 style="color: var(--primary);">Full Growth Retainer</h2>
                <span class="feature-price">$5,200 / week</span>
                <p class="feature-desc">The ultimate "Scale-Up" partnership. We deploy our entire team into your Slack channel. We don't just advise; we execute, hire, and build alongside you.</p>
                <ul class="feature-list" style="color: white;">
                    <li>✓ Dedicated Growth Team</li>
                    <li>✓ Unlimited Projects</li>
                    <li>✓ Weekly Strategy Calls</li>
                    <li>✓ Hiring Support</li>
                </ul>
            </div>
            <div class="feature-visual" style="border-color: var(--primary);">
                <div style="text-align: center;">
                    <h3 style="margin-bottom: 1rem;">YOUR BUSINESS + OUR TEAM</h3>
                    <div style="font-size: 4rem;">🚀</div>
                    <p style="margin-top: 1rem; color: var(--primary);">Partnership Mode: ON</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Survey -->
    <section class="survey-section" id="survey">
        <div class="container">
            <div class="survey-container">
                <div style="text-align: center; margin-bottom: 2rem;">
                    <h2>Build Your Scaling Roadmap</h2>
                    <p style="color: var(--text-muted);">Answer 4 questions to verify qualification.</p>
                    <div style="height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; margin-top: 1.5rem; overflow: hidden;">
                        <div id="progressFill" style="height: 100%; width: 25%; background: var(--primary); transition: width 0.3s;"></div>
                    </div>
                </div>

                <form id="surveyForm">
                    <!-- Step 1 -->
                    <div class="form-step" data-step="1">
                        <h3 class="mb-4">1. What's your top bottleneck?</h3>
                        <div class="options-grid">
                            <label class="option-card"><input type="radio" name="bottleneck" value="leads"><span class="option-text">Generating Leads</span></label>
                            <label class="option-card"><input type="radio" name="bottleneck" value="delivery"><span class="option-text">Operations / Delivery</span></label>
                            <label class="option-card"><input type="radio" name="bottleneck" value="hiring"><span class="option-text">Team / Hiring</span></label>
                            <label class="option-card"><input type="radio" name="bottleneck" value="time"><span class="option-text">My Personal Time</span></label>
                        </div>
                        <div class="text-right" style="margin-top: 2rem; display: flex; justify-content: flex-end;">
                            <button type="button" class="cta-primary" onclick="nextStep()">Next →</button>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="form-step" data-step="2" style="display:none;">
                        <h3 class="mb-4">2. Current Revenue</h3>
                        <div class="options-grid">
                            <label class="option-card"><input type="radio" name="revenue" value="<500k"><span class="option-text">$250k - $500k</span></label>
                            <label class="option-card"><input type="radio" name="revenue" value="500k-1m"><span class="option-text">$500k - $1M</span></label>
                            <label class="option-card"><input type="radio" name="revenue" value="1m-5m"><span class="option-text">$1M - $5M</span></label>
                            <label class="option-card"><input type="radio" name="revenue" value="5m+"><span class="option-text">$5M+</span></label>
                        </div>
                         <div class="text-right" style="margin-top: 2rem; display: flex; justify-content: flex-end;">
                            <button type="button" class="cta-primary" onclick="nextStep()">Next →</button>
                        </div>
                    </div>

                     <!-- Step 3 -->
                    <div class="form-step" data-step="3" style="display:none;">
                        <h3 class="mb-4">3. Which Service?</h3>
                        <div class="options-grid">
                            <label class="option-card"><input type="checkbox" name="service" value="ads"><span class="option-text">Paid Ads</span></label>
                            <label class="option-card"><input type="checkbox" name="service" value="funnels"><span class="option-text">Funnels</span></label>
                            <label class="option-card"><input type="checkbox" name="service" value="automation"><span class="option-text">Automation</span></label>
                            <label class="option-card"><input type="checkbox" name="service" value="retainer"><span class="option-text">Full Retainer</span></label>
                        </div>
                         <div class="text-right" style="margin-top: 2rem; display: flex; justify-content: flex-end;">
                            <button type="button" class="cta-primary" onclick="nextStep()">Next →</button>
                        </div>
                    </div>

                    <!-- Step 4 -->
                    <div class="form-step" data-step="4" style="display:none;">
                        <h3 class="mb-4">4. Final Details</h3>
                        <input type="text" name="name" placeholder="Your Name" style="width: 100%; padding: 1rem; margin-bottom: 1rem; background: rgba(0,0,0,0.3); border: 1px solid #444; color: white;">
                        <input type="email" name="email" placeholder="Work Email" style="width: 100%; padding: 1rem; margin-bottom: 1rem; background: rgba(0,0,0,0.3); border: 1px solid #444; color: white;">
                         <div class="text-right" style="margin-top: 2rem; display: flex; justify-content: flex-end;">
                            <button type="submit" class="cta-primary">Submit Application 🚀</button>
                        </div>
                    </div>
                </form>
                <div id="success" style="display:none; text-align: center;">
                    <h1>🎉 Received!</h1>
                    <p>We will be in touch shortly.</p>
                </div>
            </div>
        </div>
    </section>

    <footer style="padding: 2rem; text-align: center; color: #666; border-top: 1px solid #222;">
        &copy; 2026 Jumpstart Scaling
    </footer>

    <script is:inline>
        const canvas = document.getElementById('canvas-container');
        const ctx = canvas.getContext('2d');
        let width, height;
        const particles = [];
        
        function resize() { width = canvas.width = window.innerWidth; height = canvas.height = window.innerHeight; }
        window.addEventListener('resize', resize);
        resize();

        for(let i=0; i<50; i++) particles.push({x: Math.random()*width, y: Math.random()*height, vx: (Math.random()-.5), vy: (Math.random()-.5)});

        function animate() {
            ctx.clearRect(0,0,width,height);
            particles.forEach(p => {
                p.x += p.vx; p.y += p.vy;
                if(p.x<0||p.x>width) p.vx*=-1; if(p.y<0||p.y>height) p.vy*=-1;
                ctx.fillStyle = 'rgba(255,107,53,0.5)'; ctx.beginPath(); ctx.arc(p.x, p.y, 2, 0, Math.PI*2); ctx.fill();
            });
            requestAnimationFrame(animate);
        }
        animate();

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
        }, { threshold: 0.2 });
        document.querySelectorAll('.feature-visual').forEach(el => observer.observe(el));

        let step = 1;
        window.nextStep = () => {
            document.querySelector(`[data-step="${step}"]`).style.display = 'none';
            step++;
            document.querySelector(`[data-step="${step}"]`).style.display = 'block';
            document.getElementById('progressFill').style.width = (step/4*100)+'%';
        };

         document.getElementById('surveyForm').addEventListener('submit', (e) => {
            e.preventDefault();
            document.getElementById('surveyForm').style.display = 'none';
            document.getElementById('success').style.display = 'block';
             const n8n = 'https://n8n.jumpstartscaling.com/webhook/YOUR_UNIQUE_ID'; 
             if(n8n.includes('http')) fetch(n8n, { method: 'POST', body: new FormData(e.target) });
        });
        
        document.querySelectorAll('.option-card input').forEach(input => {
            input.addEventListener('change', function() {
                if(this.type === 'radio') this.closest('.options-grid').querySelectorAll('.option-card').forEach(c => c.classList.remove('selected'));
                this.parentElement.classList.toggle('selected', this.checked);
            });
        });
    </script>
</body>
</html>
