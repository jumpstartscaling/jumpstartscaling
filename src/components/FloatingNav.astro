---
/**
 * FloatingNav.astro
 * 
 * Premium floating navigation bar with dropdown menus
 * Features:
 * - Glassmorphism effect
 * - Smooth animations
 * - Dropdown submenus
 * - Mobile responsive
 * - Scroll-aware (hides on scroll down, shows on scroll up)
 */

interface NavItem {
  name: string;
  href: string;
  children?: NavItem[];
}

interface Props {
  navItems: NavItem[];
  ctaText?: string;
  ctaHref?: string;
}

const { 
  navItems, 
  ctaText = "Apply Now",
  ctaHref = "/apply" 
} = Astro.props;
---

<nav id="floating-nav" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 px-6 py-3 bg-black/80 backdrop-blur-lg border border-gold-900/20 rounded-full shadow-2xl shadow-black/50 transition-all duration-300 hover:shadow-gold-500/20">
  <ul class="flex items-center gap-8">
    {navItems.map((item) => (
      <li class="relative group hidden md:block">
        <a 
          href={item.href} 
          class="text-gray-300 hover:text-gold-400 transition-colors font-medium text-sm"
        >
          {item.name}
          {item.children && (
            <svg class="inline-block w-4 h-4 ml-1 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          )}
        </a>
        
        {item.children && (
          <div class="absolute top-full left-0 mt-2 w-56 bg-black/95 backdrop-blur-lg border border-gold-900/30 rounded-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 shadow-2xl overflow-hidden">
            {item.children.map((child) => (
              <a 
                href={child.href} 
                class="block px-4 py-3 text-gray-400 hover:text-gold-400 hover:bg-gold-900/10 transition-colors text-sm border-b border-gold-900/10 last:border-0"
              >
                {child.name}
              </a>
            ))}
          </div>
        )}
      </li>
    ))}
    
    <!-- Mobile Menu Toggle -->
    <li class="md:hidden">
      <button id="mobile-menu-toggle" class="p-2 text-gold-400 hover:text-gold-300">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </li>
    
    <!-- CTA Button -->
    <li>
      <a 
        href={ctaHref} 
        class="px-6 py-2 bg-gradient-to-r from-gold-600 to-gold-500 rounded-full text-black font-semibold text-sm hover:scale-105 transition-transform shadow-lg shadow-gold-500/20"
      >
        {ctaText}
      </a>
    </li>
  </ul>
</nav>

<!-- Mobile Menu -->
<div id="mobile-menu" class="fixed inset-0 bg-black/95 backdrop-blur-lg z-40 hidden">
  <div class="p-6">
    <div class="flex justify-between items-center mb-8">
      <div class="text-2xl font-bold bg-clip-text text-transparent bg-gold-metal">
        Menu
      </div>
      <button id="mobile-menu-close" class="p-2 text-gold-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <ul class="space-y-4">
      {navItems.map((item) => (
        <li>
          <a 
            href={item.href} 
            class="block text-xl text-gray-300 hover:text-gold-400 transition-colors py-2"
          >
            {item.name}
          </a>
          {item.children && (
            <ul class="ml-4 mt-2 space-y-2">
              {item.children.map((child) => (
                <li>
                  <a 
                    href={child.href} 
                    class="block text-gray-400 hover:text-gold-400 transition-colors py-1"
                  >
                    {child.name}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li class="pt-4">
        <a 
          href={ctaHref} 
          class="block text-center px-6 py-3 bg-gradient-to-r from-gold-600 to-gold-500 rounded-lg text-black font-semibold"
        >
          {ctaText}
        </a>
      </li>
    </ul>
  </div>
</div>

<!-- Scroll Progress Indicator -->
<div class="fixed top-0 left-0 right-0 h-1 bg-gray-900 z-50">
  <div id="scroll-progress" class="h-full bg-gradient-to-r from-gold-600 to-gold-400 transition-all duration-150" style="width: 0%"></div>
</div>

<script>
  // Mobile menu toggle
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileClose = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  
  mobileToggle?.addEventListener('click', () => {
    mobileMenu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  });
  
  mobileClose?.addEventListener('click', () => {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = 'auto';
  });
  
  // Scroll progress
  window.addEventListener('scroll', () => {
    const winScroll = document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const progressBar = document.getElementById('scroll-progress');
    if (progressBar) {
      progressBar.style.width = scrolled + '%';
    }
  });
  
  // Hide/show nav on scroll
  let lastScroll = 0;
  const nav = document.getElementById('floating-nav');
  
  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;
    
    if (currentScroll <= 0) {
      nav?.classList.remove('-translate-y-20');
      return;
    }
    
    if (currentScroll > lastScroll && currentScroll > 100) {
      // Scrolling down
      nav?.classList.add('-translate-y-20');
    } else {
      // Scrolling up
      nav?.classList.remove('-translate-y-20');
    }
    
    lastScroll = currentScroll;
  });
</script>

<style>
  #floating-nav {
    transition: transform 0.3s ease-in-out;
  }
</style>
