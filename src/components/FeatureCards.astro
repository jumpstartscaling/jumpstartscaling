---
/**
 * FeatureCards.astro
 * 
 * Interactive feature cards with:
 * - Hover glow effects
 * - Icon integration
 * - Benefit lists
 * - CTA links
 * - Responsive grid layout
 */

interface Benefit {
  text: string;
}

interface Feature {
  icon: string; // SVG path data
  title: string;
  description: string;
  benefits: Benefit[];
  link: string;
}

interface Props {
  features: Feature[];
  sectionTitle?: string;
  sectionSubtitle?: string;
}

const { features, sectionTitle, sectionSubtitle } = Astro.props;
---

<section class="py-20 px-4 bg-black">
  <div class="max-w-7xl mx-auto">
    {sectionTitle && (
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-gold-metal mb-4">
          {sectionTitle}
        </h2>
        {sectionSubtitle && (
          <p class="text-xl text-gray-400 max-w-3xl mx-auto">
            {sectionSubtitle}
          </p>
        )}
      </div>
    )}
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature, index) => (
        <div 
          class="group relative p-8 bg-gradient-to-br from-gray-900 to-black border border-gold-900/20 rounded-xl hover:border-gold-500/50 transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:shadow-gold-500/10"
          data-aos="fade-up"
          data-aos-delay={index * 100}
        >
          <!-- Glow effect on hover -->
          <div class="absolute inset-0 bg-gradient-to-r from-gold-600/0 via-gold-600/10 to-gold-600/0 opacity-0 group-hover:opacity-100 transition-opacity rounded-xl"></div>
          
          <div class="relative z-10">
            <!-- Icon -->
            <div class="w-14 h-14 bg-gold-500/10 rounded-lg flex items-center justify-center mb-6 group-hover:bg-gold-500/20 group-hover:scale-110 transition-all">
              <svg class="w-7 h-7 text-gold-500" fill="currentColor" viewBox="0 0 20 20">
                <path d={feature.icon}></path>
              </svg>
            </div>
            
            <!-- Content -->
            <h3 class="text-2xl font-bold text-white mb-3">{feature.title}</h3>
            <p class="text-gray-400 mb-6 leading-relaxed">{feature.description}</p>
            
            <!-- Benefits -->
            <ul class="space-y-2 mb-6">
              {feature.benefits.map((benefit) => (
                <li class="flex items-start gap-2 text-sm text-gray-500">
                  <svg class="w-5 h-5 text-gold-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                  <span>{benefit.text}</span>
                </li>
              ))}
            </ul>
            
            <!-- CTA -->
            <a 
              href={feature.link} 
              class="inline-flex items-center gap-2 text-gold-400 hover:text-gold-300 font-semibold group/link"
            >
              Learn More
              <svg class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Simple AOS (Animate On Scroll) implementation
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -100px 0px'
  };
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('aos-animate');
      }
    });
  }, observerOptions);
  
  document.querySelectorAll('[data-aos]').forEach(el => {
    observer.observe(el);
  });
</script>

<style>
  [data-aos] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  
  [data-aos].aos-animate {
    opacity: 1;
    transform: translateY(0);
  }
  
  [data-aos-delay="100"].aos-animate {
    transition-delay: 0.1s;
  }
  
  [data-aos-delay="200"].aos-animate {
    transition-delay: 0.2s;
  }
</style>
