---
/**
 * BentoGrid.astro
 * 
 * Modern bento-style grid layout with:
 * - Variable sized cells
 * - Interactive hover effects
 * - Canvas visualizations
 * - Responsive design
 */

interface BentoItem {
  title: string;
  description?: string;
  size: 'small' | 'medium' | 'large'; // 1x1, 2x1, 2x2
  link?: string;
  icon?: string;
  canvasId?: string;
}

interface Props {
  items: BentoItem[];
  sectionTitle?: string;
}

const { items, sectionTitle } = Astro.props;

// Helper to get grid classes based on size
const getSizeClasses = (size: string) => {
  switch(size) {
    case 'large':
      return 'md:col-span-2 md:row-span-2';
    case 'medium':
      return 'md:col-span-2 md:row-span-1';
    default:
      return 'md:col-span-1 md:row-span-1';
  }
};
---

<section class="py-20 px-4 bg-black">
  <div class="max-w-7xl mx-auto">
    {sectionTitle && (
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-16 bg-clip-text text-transparent bg-gold-metal">
        {sectionTitle}
      </h2>
    )}
    
    <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-3 gap-4 auto-rows-fr">
      {items.map((item) => (
        <div 
          class={`group relative bg-gradient-to-br from-gold-900/20 to-black border border-gold-900/30 rounded-2xl p-6 md:p-8 hover:border-gold-500/50 transition-all overflow-hidden ${getSizeClasses(item.size)}`}
        >
          <!-- Hover glow effect -->
          <div class="absolute inset-0 bg-gradient-to-r from-gold-600/0 via-gold-600/10 to-gold-600/0 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          
          <div class="relative z-10 h-full flex flex-col">
            <!-- Icon (if provided) -->
            {item.icon && (
              <div class="w-12 h-12 bg-gold-500/10 rounded-xl flex items-center justify-center mb-4 group-hover:bg-gold-500/20 transition-colors">
                <svg class="w-6 h-6 text-gold-500" fill="currentColor" viewBox="0 0 20 20">
                  <path d={item.icon}></path>
                </svg>
              </div>
            )}
            
            <!-- Title -->
            <h3 class={`font-bold mb-2 ${item.size === 'large' ? 'text-3xl' : 'text-xl'}`}>
              {item.title}
            </h3>
            
            <!-- Description -->
            {item.description && (
              <p class="text-gray-400 mb-4 flex-grow">
                {item.description}
              </p>
            )}
            
            <!-- Canvas visualization (for large items) -->
            {item.canvasId && (
              <canvas 
                id={item.canvasId} 
                class="w-full h-48 mt-auto"
              ></canvas>
            )}
            
            <!-- Link -->
            {item.link && (
              <a 
                href={item.link} 
                class="inline-flex items-center text-gold-400 hover:text-gold-300 mt-auto group/link"
              >
                Learn More
                <svg class="w-4 h-4 ml-1 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  /**
   * Simple canvas visualization for bento grid items
   * This creates animated particles/lines as a visual element
   */
  function initCanvasViz(canvasId: string) {
    const canvas = document.getElementById(canvasId) as HTMLCanvasElement;
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    
    // Set canvas size
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
    
    // Particle system
    const particles: Array<{x: number, y: number, vx: number, vy: number}> = [];
    const particleCount = 30;
    
    // Create particles
    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5
      });
    }
    
    // Animation loop
    function animate() {
      if (!ctx || !canvas) return;
      
      ctx.fillStyle = 'rgba(0, 0, 0, 0.1)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      
      // Update and draw particles
      particles.forEach((p, i) => {
        p.x += p.vx;
        p.y += p.vy;
        
        // Bounce off edges
        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        
        // Draw particle
        ctx.fillStyle = 'rgba(191, 149, 63, 0.5)';
        ctx.beginPath();
        ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
        ctx.fill();
        
        // Draw connections
        particles.slice(i + 1).forEach(p2 => {
          const dx = p2.x - p.x;
          const dy = p2.y - p.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          
          if (dist < 100) {
            ctx.strokeStyle = `rgba(191, 149, 63, ${0.2 * (1 - dist / 100)})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        });
      });
      
      requestAnimationFrame(animate);
    }
    
    animate();
  }
  
  // Initialize all canvas visualizations
  document.querySelectorAll('canvas[id]').forEach(canvas => {
    initCanvasViz(canvas.id);
  });
</script>
