---
/**
 * TerminalWindow.astro
 * 
 * A Mac-style terminal window with syntax highlighting and typing effect.
 * Perfect for showing "how it works" without boring text.
 */

interface Props {
  title?: string;
  codeLines: string[];
  language?: string;
}

const { 
  title = "workflow_engine.ts", 
  codeLines,
  language = "typescript" 
} = Astro.props;
---

<div class="relative w-full max-w-3xl mx-auto transform hover:scale-[1.01] transition-transform duration-500">
  <!-- Glow Effect -->
  <div class="absolute -inset-0.5 bg-gradient-to-r from-gold-600 via-yellow-500 to-gold-400 opacity-30 blur-2xl"></div>
  
  <!-- Terminal Window -->
  <div class="relative bg-[#0d1117] rounded-xl border border-gold-900/30 shadow-2xl overflow-hidden">
    <!-- Title Bar -->
    <div class="flex items-center px-4 py-3 bg-white/5 border-b border-white/5">
      <div class="flex space-x-2">
        <div class="w-3 h-3 rounded-full bg-red-500"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
        <div class="w-3 h-3 rounded-full bg-green-500"></div>
      </div>
      <div class="ml-4 text-xs text-gray-400 font-mono flex items-center gap-2">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        {title}
      </div>
    </div>
    
    <!-- Code Content -->
    <div class="p-6 overflow-x-auto">
      <div class="font-mono text-sm md:text-base leading-relaxed">
        {codeLines.map((line, index) => (
          <div class="flex group">
            <span class="w-8 text-gray-600 select-none text-right mr-4">{index + 1}</span>
            <span class="text-gray-300 group-hover:text-gold-100 transition-colors" set:html={line}></span>
          </div>
        ))}
        <!-- Blinking Cursor -->
        <div class="flex mt-1">
          <span class="w-8 mr-4"></span>
          <span class="w-2 h-5 bg-gold-400 animate-pulse"></span>
        </div>
      </div>
    </div>
  </div>
</div>
