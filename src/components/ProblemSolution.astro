---
/**
 * ProblemSolution.astro
 * 
 * Two-column problem/solution framework with:
 * - Problem side (red accents)
 * - Solution side (gold accents)
 * - Icon lists
 * - Visual contrast
 */

interface ListItem {
  text: string;
}

interface Props {
  problemTitle: string;
  problemDescription: string;
  problems: ListItem[];
  solutionTitle: string;
  solutionDescription: string;
  solutions: ListItem[];
  ctaText?: string;
  ctaHref?: string;
}

const {
  problemTitle,
  problemDescription,
  problems,
  solutionTitle,
  solutionDescription,
  solutions,
  ctaText = "See How It Works",
  ctaHref = "/services"
} = Astro.props;
---

<section class="py-20 px-4 bg-black">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <!-- Problem Side -->
      <div class="space-y-6" data-aos="fade-right">
        <div class="inline-block px-4 py-2 bg-red-500/10 border border-red-500/30 rounded-full text-red-400 text-sm font-semibold mb-4">
          The Problem
        </div>
        
        <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight">
          {problemTitle}
        </h2>
        
        <p class="text-gray-400 text-lg leading-relaxed">
          {problemDescription}
        </p>
        
        <ul class="space-y-3 pt-4">
          {problems.map((problem) => (
            <li class="flex items-start gap-3 group">
              <svg class="w-6 h-6 text-red-500 flex-shrink-0 mt-1 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-400 leading-relaxed">{problem.text}</span>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Solution Side -->
      <div class="space-y-6" data-aos="fade-left">
        <div class="inline-block px-4 py-2 bg-gold-500/10 border border-gold-500/30 rounded-full text-gold-400 text-sm font-semibold mb-4">
          The Solution
        </div>
        
        <h2 class="text-3xl md:text-4xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-gold-200 to-gold-600 leading-tight">
          {solutionTitle}
        </h2>
        
        <p class="text-gray-400 text-lg leading-relaxed">
          {solutionDescription}
        </p>
        
        <ul class="space-y-3 pt-4">
          {solutions.map((solution) => (
            <li class="flex items-start gap-3 group">
              <svg class="w-6 h-6 text-gold-500 flex-shrink-0 mt-1 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-300 leading-relaxed">{solution.text}</span>
            </li>
          ))}
        </ul>
        
        {ctaText && ctaHref && (
          <div class="pt-6">
            <a 
              href={ctaHref} 
              class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-gold-600 to-gold-500 rounded-lg text-black font-bold hover:scale-105 transition-transform shadow-lg shadow-gold-500/20"
            >
              {ctaText} →
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px'
  };
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('aos-animate');
      }
    });
  }, observerOptions);
  
  document.querySelectorAll('[data-aos]').forEach(el => {
    observer.observe(el);
  });
</script>

<style>
  [data-aos="fade-right"] {
    opacity: 0;
    transform: translateX(-50px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  
  [data-aos="fade-left"] {
    opacity: 0;
    transform: translateX(50px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  
  [data-aos].aos-animate {
    opacity: 1;
    transform: translateX(0);
  }
</style>
