---
/**
 * BlogGrid.astro
 * 
 * Blog/Knowledge base card grid with:
 * - Featured images
 * - Category badges
 * - Read time
 * - Hover animations
 * - Responsive grid
 */

interface Post {
  title: string;
  excerpt: string;
  slug: string;
  category: string;
  readTime: number;
  date: string;
  emoji?: string;
  image?: string;
}

interface Props {
  posts: Post[];
  sectionTitle?: string;
  viewAllLink?: string;
  viewAllText?: string;
}

const { 
  posts, 
  sectionTitle = "Latest Insights",
  viewAllLink = "/knowledge",
  viewAllText = "View All"
} = Astro.props;
---

<section class="py-20 px-4 bg-black">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-12">
      <h2 class="text-3xl md:text-4xl font-bold bg-clip-text text-transparent bg-gold-metal">
        {sectionTitle}
      </h2>
      {viewAllLink && (
        <a 
          href={viewAllLink} 
          class="text-gold-400 hover:text-gold-300 font-semibold flex items-center gap-2 group"
        >
          {viewAllText}
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      )}
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post, index) => (
        <article 
          class="group bg-gradient-to-br from-gray-900 to-black border border-gold-900/20 rounded-xl overflow-hidden hover:border-gold-500/50 transition-all hover:scale-105 hover:shadow-2xl hover:shadow-gold-500/10"
          data-aos="fade-up"
          data-aos-delay={index * 100}
        >
          <!-- Featured Image / Emoji -->
          <div class="aspect-video bg-gradient-to-br from-gold-900/20 to-black relative overflow-hidden">
            {post.image ? (
              <img 
                src={post.image} 
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
            ) : (
              <>
                <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-20"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="text-6xl">{post.emoji || '📝'}</span>
                </div>
              </>
            )}
            
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>
          
          <!-- Content -->
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-gold-500/10 border border-gold-500/30 rounded-full text-gold-400 text-xs font-semibold">
                {post.category}
              </span>
              <span class="text-gray-500 text-sm">{post.readTime} min read</span>
            </div>
            
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-gold-400 transition-colors line-clamp-2">
              {post.title}
            </h3>
            
            <p class="text-gray-400 text-sm mb-4 line-clamp-3 leading-relaxed">
              {post.excerpt}
            </p>
            
            <div class="flex items-center justify-between">
              <span class="text-gray-500 text-sm">{post.date}</span>
              <a 
                href={post.slug} 
                class="text-gold-400 hover:text-gold-300 text-sm font-semibold flex items-center gap-1 group/link"
              >
                Read More
                <svg class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('aos-animate');
      }
    });
  }, observerOptions);
  
  document.querySelectorAll('[data-aos]').forEach(el => {
    observer.observe(el);
  });
</script>

<style>
  [data-aos] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  
  [data-aos].aos-animate {
    opacity: 1;
    transform: translateY(0);
  }
  
  [data-aos-delay="100"].aos-animate {
    transition-delay: 0.1s;
  }
  
  [data-aos-delay="200"].aos-animate {
    transition-delay: 0.2s;
  }
  
  /* Line clamp utilities */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
