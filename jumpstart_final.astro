---
import SEOTags from '../components/SEOTags.astro';
import GTMTracking from '../components/GTMTracking.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

const title = 'Jumpstart Scaling - Break Through The 7-Figure Ceiling';
const description = 'The proven methodology that helped 500+ founders automate operations, reclaim 20 hours a week, and build a valuation-ready asset in 90 days.';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <SEOTags title={title} description={description} />
    <SchemaOrg />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #FF6B35;
            --primary-dark: #E85A2A;
            --secondary: #4ECDC4;
            --dark: #0a0a0f;
            --dark-2: #12121a;
            --dark-3: #1a1a28;
            --text: #ffffff;
            --text-muted: #9CA3AF;
            --accent: #FFD93D;
            --glow: rgba(255, 107, 53, 0.5);
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background: var(--dark);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
            position: relative;
        }
        
        /* Cyberpunk Grid Background */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                linear-gradient(90deg, rgba(255,107,53,0.03) 1px, transparent 1px),
                linear-gradient(rgba(78,205,196,0.03) 1px, transparent 1px);
            background-size: 50px 50px;
            z-index: 0;
            pointer-events: none;
        }
        
        .container { max-width: 1400px; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 1; }
        
        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .hero::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, var(--glow) 0%, transparent 70%);
            animation: pulse 4s ease-in-out infinite;
        }
        
        @keyframes pulse {
            0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.3; }
            50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.5; }
        }
        
        .hero h1 {
            font-size: clamp(3rem, 8vw, 6rem);
            font-weight: 900;
            margin-bottom: 2rem;
            background: linear-gradient(135deg, #fff 0%, var(--secondary) 50%, var(--primary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            position: relative;
            z-index: 2;
        }
        
        .hero .subtitle {
            font-size: clamp(1.2rem, 3vw, 1.8rem);
            color: var(--text-muted);
            max-width: 900px;
            margin: 0 auto 3rem;
            position: relative;
            z-index: 2;
        }
        
        .cta-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            padding: 1.5rem 4rem;
            font-size: 1.3rem;
            font-weight: 700;
            border-radius: 50px;
            text-decoration: none;
            display: inline-block;
            border: 2px solid var(--primary);
            box-shadow: 0 0 30px var(--glow), 0 10px 40px rgba(0,0,0,0.5);
            transition: all 0.3s ease;
            position: relative;
            z-index: 2;
            cursor: pointer;
        }
        
        .cta-primary:hover {
            transform: translateY(-5px);
            box-shadow: 0 0 50px var(--glow), 0 20px 60px rgba(0,0,0,0.7);
        }
        
        /* Service Section */
        .section {
            padding: 8rem 0;
            position: relative;
        }
        
        .section:nth-child(even) {
            background: linear-gradient(180deg, transparent 0%, rgba(255,107,53,0.02) 50%, transparent 100%);
        }
        
        .service-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
            max-width: 1300px;
            margin: 0 auto;
        }
        
        .service-header {
            text-align: center;
            margin-bottom: 4rem;
        }
        
        .service-header h2 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 900;
            margin-bottom: 1rem;
            color: var(--primary);
            text-shadow: 0 0 20px var(--glow);
        }
        
        .service-price {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--secondary);
            text-shadow: 0 0 15px rgba(78,205,196,0.5);
        }
        
        .price-sub {
            font-size: 1.2rem;
            color: var(--text-muted);
            font-weight: 500;
        }
        
        /* Neon Cards */
        .card {
            background: rgba(26, 26, 40, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,107,53,0.2);
            padding: 2.5rem;
            border-radius: 20px;
            margin-bottom: 1.5rem;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        
        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,107,53,0.1), transparent);
            transition: left 0.5s;
        }
        
        .card:hover::before {
            left: 100%;
        }
        
        .card:hover {
            border-color: var(--primary);
            box-shadow: 0 0 30px rgba(255,107,53,0.3);
            transform: translateY(-5px);
        }
        
        .card h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: #fff;
        }
        
        .card p {
            color: #ccc;
            line-height: 1.8;
            font-size: 1.05rem;
        }
        
        .card ul {
            list-style: none;
            margin-top: 1.5rem;
        }
        
        .card li {
            color: #ccc;
            margin-bottom: 1rem;
            padding-left: 2rem;
            position: relative;
            font-size: 1.05rem;
        }
        
        .card li::before {
            content: '▸';
            color: var(--secondary);
            position: absolute;
            left: 0;
            font-weight: bold;
            font-size: 1.3rem;
        }
        
        .testimonial {
            background: rgba(255, 107, 53, 0.08);
            border-color: var(--primary);
            font-style: italic;
        }
        
        /* Code Visual Containers */
        .code-visual {
            width: 100%;
            height: 500px;
            border-radius: 20px;
            position: relative;
            overflow: hidden;
            background: var(--dark-2);
            border: 1px solid rgba(78,205,196,0.3);
            box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 30px rgba(78,205,196,0.2);
        }
        
        /* Footer */
        footer {
            padding: 4rem 0;
            border-top: 1px solid rgba(255,107,53,0.2);
            text-align: center;
            color: var(--text-muted);
            background: var(--dark-2);
        }
        
        footer a {
            color: var(--text-muted);
            text-decoration: none;
            margin: 0 1rem;
            transition: color 0.3s;
        }
        
        footer a:hover {
            color: var(--primary);
        }
        
        @media(max-width: 968px) {
            .service-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            .section {
                padding: 4rem 0;
            }
        }
    </style>
</head>
<body>
    <!-- Hero -->
    <section class="hero">
        <div class="container">
            <h1>Scale From 7 to 8 Figures<br>Without The Burnout</h1>
            <p class="subtitle">
                The Jumpstart Methodology: Automate operations, install self-managing teams, 
                and build a valuation-ready asset in 90 days or less.
            </p>
            <a href="#survey" class="cta-primary">Get Your Free Scaling Blueprint</a>
        </div>
    </section>

    <!-- Service 1: Paid Ads -->
    <section class="section">
        <div class="container">
            <div class="service-header">
                <h2>Paid Acquisition Engine</h2>
                <p class="service-price">$2,250<span class="price-sub">/month</span></p>
            </div>
            
            <div class="service-grid">
                <div>
                    <div class="card">
                        <h3>The Problem: You're Trapped in the Referral Hamster Wheel</h3>
                        <p>Referrals are great—until they're not. Your growth is completely at the mercy of your existing client's schedules and moods. One bad quarter? Your pipeline dries up. You can't forecast. You can't plan hires.</p>
                    </div>
                    
                    <div class="card">
                        <h3 style="color: var(--secondary);">The Solution: A Predictable Lead Machine</h3>
                        <p>We build and manage a self-sustaining acquisition system that turns $1 into $5. Every day, we're optimizing your ad spend, killing underperformers, and scaling winners.</p>
                        <ul>
                            <li><strong>Daily Ads Management</strong> - We monitor performance hourly, not monthly</li>
                            <li><strong>Creative Testing</strong> - New ad angles every week to beat fatigue</li>
                            <li><strong>Multi-Platform Scaling</strong> - Google, Facebook, LinkedIn</li>
                            <li><strong>ROI Dashboards</strong> - Real-time tracking</li>
                        </ul>
                    </div>
                    
                    <div class="card testimonial">
                        <p>"We went from 2-3 inbound leads per month to 40+ qualified SQLs. For the first time in 5 years, I can actually forecast revenue." - Agency Owner, $2.8M ARR</p>
                    </div>
                </div>
                
                <div class="code-visual">
                    <svg width="100%" height="100%" viewBox="0 0 500 500">
                        <!-- Rocket -->
                        <defs>
                            <linearGradient id="rocketGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#FF6B35;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#4ECDC4;stop-opacity:1" />
                            </linearGradient>
                            <filter id="glow">
                                <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
                                <feMerge>
                                    <feMergeNode in="coloredBlur"/>
                                    <feMergeNode in="SourceGraphic"/>
                                </feMerge>
                            </filter>
                        </defs>
                        
                        <!-- Rocket Body -->
                        <ellipse cx="250" cy="300" rx="40" ry="80" fill="url(#rocketGrad)" filter="url(#glow)">
                            <animateTransform attributeName="transform" type="translate" values="0 0; 0 -10; 0 0" dur="2s" repeatCount="indefinite"/>
                        </ellipse>
                        
                        <!-- Rocket Nose -->
                        <polygon points="250,200 220,250 280,250" fill="#4ECDC4" filter="url(#glow)">
                            <animateTransform attributeName="transform" type="translate" values="0 0; 0 -10; 0 0" dur="2s" repeatCount="indefinite"/>
                        </polygon>
                        
                        <!-- Flames -->
                        <ellipse cx="250" cy="380" rx="30" ry="40" fill="#FFD93D" opacity="0.8">
                            <animate attributeName="ry" values="40;50;40" dur="0.5s" repeatCount="indefinite"/>
                            <animate attributeName="opacity" values="0.8;1;0.8" dur="0.5s" repeatCount="indefinite"/>
                        </ellipse>
                        
                        <!-- Stars -->
                        <circle cx="100" cy="100" r="2" fill="#fff">
                            <animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite"/>
                        </circle>
                        <circle cx="400" cy="150" r="2" fill="#fff">
                            <animate attributeName="opacity" values="0.3;1;0.3" dur="3s" repeatCount="indefinite"/>
                        </circle>
                        <circle cx="150" cy="400" r="2" fill="#fff">
                            <animate attributeName="opacity" values="0.3;1;0.3" dur="2.5s" repeatCount="indefinite"/>
                        </circle>
                        
                        <!-- Growth Arrow -->
                        <path d="M 50 450 L 450 50" stroke="#4ECDC4" stroke-width="3" fill="none" stroke-dasharray="10,5" opacity="0.5">
                            <animate attributeName="stroke-dashoffset" from="0" to="30" dur="2s" repeatCount="indefinite"/>
                        </path>
                        <polygon points="450,50 430,60 440,70" fill="#4ECDC4" opacity="0.5"/>
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <!-- Service 2: Funnels -->
    <section class="section">
        <div class="container">
            <div class="service-header">
                <h2>Funnel Architecture</h2>
                <p class="service-price">$3,500<span class="price-sub">/project</span></p>
            </div>
            
            <div class="service-grid">
                <div class="code-visual">
                    <svg width="100%" height="100%" viewBox="0 0 500 500">
                        <defs>
                            <linearGradient id="funnelGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" style="stop-color:#FF6B35;stop-opacity:1" />
                                <stop offset="50%" style="stop-color:#FFD93D;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#4ECDC4;stop-opacity:1" />
                            </linearGradient>
                        </defs>
                        
                        <!-- Funnel Shape -->
                        <path d="M 100 100 L 400 100 L 300 400 L 200 400 Z" fill="url(#funnelGrad)" opacity="0.7" filter="url(#glow)"/>
                        
                        <!-- Stage Lines -->
                        <line x1="120" y1="180" x2="380" y2="180" stroke="#fff" stroke-width="2" opacity="0.5"/>
                        <line x1="160" y1="260" x2="340" y2="260" stroke="#fff" stroke-width="2" opacity="0.5"/>
                        <line x1="200" y1="340" x2="300" y2="340" stroke="#fff" stroke-width="2" opacity="0.5"/>
                        
                        <!-- Percentage Labels -->
                        <text x="420" y="140" fill="#FF6B35" font-size="16" font-weight="bold">100%</text>
                        <text x="420" y="220" fill="#FFD93D" font-size="16" font-weight="bold">40%</text>
                        <text x="420" y="300" fill="#4ECDC4" font-size="16" font-weight="bold">15%</text>
                        
                        <!-- Flowing Particles -->
                        <circle cx="250" cy="120" r="4" fill="#fff">
                            <animate attributeName="cy" from="120" to="380" dur="3s" repeatCount="indefinite"/>
                            <animate attributeName="opacity" values="1;0.5;0" dur="3s" repeatCount="indefinite"/>
                        </circle>
                        <circle cx="280" cy="120" r="4" fill="#fff">
                            <animate attributeName="cy" from="120" to="380" dur="3.5s" repeatCount="indefinite"/>
                            <animate attributeName="opacity" values="1;0.5;0" dur="3.5s" repeatCount="indefinite"/>
                        </circle>
                    </svg>
                </div>
                
                <div>
                    <div class="card">
                        <h3>The Problem: Traffic Doesn't Equal Revenue</h3>
                        <p>You're driving traffic to your site. People are clicking. And then... nothing. They bounce. They ghost. Your sales team is stuck chasing lukewarm leads who "need to think about it."</p>
                    </div>
                    
                    <div class="card">
                        <h3 style="color: var(--secondary);">The Solution: A Funnel That Qualifies & Converts</h3>
                        <p>We design, build, and optimize complete sales funnels that do the heavy lifting for you. From the first ad click to the booked call, every step is optimized.</p>
                        <ul>
                            <li><strong>Conversion Copywriting</strong> - Psychology-backed messaging</li>
                            <li><strong>UX/UI Design</strong> - Clean, fast, mobile-optimized</li>
                            <li><strong>Technical Integration</strong> - CRM, email, SMS, Calendly</li>
                            <li><strong>A/B Testing</strong> - Continuous optimization</li>
                        </ul>
                    </div>
                    
                    <div class="card testimonial">
                        <p>"Our funnel went from 8% conversion to 31% in 60 days. Same traffic, 4x the bookings." - SaaS Founder, $1.2M ARR</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Service 3: CRM -->
    <section class="section">
        <div class="container">
            <div class="service-header">
                <h2>CRM Transformation</h2>
                <p class="service-price">$2,500<span class="price-sub">/setup</span></p>
            </div>
            
            <div class="service-grid">
                <div>
                    <div class="card">
                        <h3>The Problem: Your CRM is a Digital Junk Drawer</h3>
                        <p>Be honest: when was the last time your CRM actually *helped* you close a deal? Right now, it's just a contact graveyard. Leads fall through the cracks. Your team forgets to follow up.</p>
                    </div>
                    
                    <div class="card">
                        <h3 style="color: var(--secondary);">The Solution: A Self-Driving CRM</h3>
                        <p>We turn your CRM from a glorified Rolodex into a revenue machine. Leads are automatically enriched, scored, and routed. Follow-ups happen on autopilot.</p>
                        <ul>
                            <li><strong>Custom Pipelines</strong> - Stages that match your process</li>
                            <li><strong>Auto-Follow Up</strong> - Email & SMS sequences</li>
                            <li><strong>Contract Automation</strong> - Proposals sent automatically</li>
                            <li><strong>Lead Scoring</strong> - AI-powered prioritization</li>
                        </ul>
                    </div>
                    
                    <div class="card testimonial">
                        <p>"We cut our sales cycle from 45 days to 18 days. Our close rate doubled." - B2B SaaS VP of Sales</p>
                    </div>
                </div>
                
                <div class="code-visual">
                    <svg width="100%" height="100%" viewBox="0 0 500 500">
                        <!-- Flowchart Boxes -->
                        <rect x="180" y="50" width="140" height="60" rx="10" fill="none" stroke="#4ECDC4" stroke-width="2" filter="url(#glow)"/>
                        <text x="250" y="85" text-anchor="middle" fill="#4ECDC4" font-size="14" font-weight="bold">New Lead</text>
                        
                        <rect x="180" y="150" width="140" height="60" rx="10" fill="none" stroke="#4ECDC4" stroke-width="2" filter="url(#glow)"/>
                        <text x="250" y="185" text-anchor="middle" fill="#4ECDC4" font-size="14" font-weight="bold">CRM Entry</text>
                        
                        <rect x="180" y="250" width="140" height="60" rx="10" fill="none" stroke="#4ECDC4" stroke-width="2" filter="url(#glow)"/>
                        <text x="250" y="285" text-anchor="middle" fill="#4ECDC4" font-size="14" font-weight="bold">Email Sequence</text>
                        
                        <rect x="50" y="370" width="140" height="60" rx="10" fill="none" stroke="#FFD93D" stroke-width="2" filter="url(#glow)"/>
                        <text x="120" y="405" text-anchor="middle" fill="#FFD93D" font-size="14" font-weight="bold">Update Record</text>
                        
                        <rect x="310" y="370" width="140" height="60" rx="10" fill="none" stroke="#FF6B35" stroke-width="2" filter="url(#glow)"/>
                        <text x="380" y="405" text-anchor="middle" fill="#FF6B35" font-size="14" font-weight="bold">Close Deal</text>
                        
                        <!-- Arrows -->
                        <path d="M 250 110 L 250 150" stroke="#4ECDC4" stroke-width="2" marker-end="url(#arrowhead)" fill="none">
                            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="2s" repeatCount="indefinite"/>
                        </path>
                        <path d="M 250 210 L 250 250" stroke="#4ECDC4" stroke-width="2" fill="none">
                            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="2s" begin="0.5s" repeatCount="indefinite"/>
                        </path>
                        <path d="M 250 310 L 120 370" stroke="#FFD93D" stroke-width="2" fill="none">
                            <animate attributeName="stroke-dasharray" values="0,200;200,0" dur="2s" begin="1s" repeatCount="indefinite"/>
                        </path>
                        <path d="M 250 310 L 380 370" stroke="#FF6B35" stroke-width="2" fill="none">
                            <animate attributeName="stroke-dasharray" values="0,200;200,0" dur="2s" begin="1s" repeatCount="indefinite"/>
                        </path>
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <!-- Service 4: Analytics -->
    <section class="section">
        <div class="container">
            <div class="service-header">
                <h2>Data & Attribution</h2>
                <p class="service-price">$1,500<span class="price-sub">/month</span></p>
            </div>
            
            <div class="service-grid">
                <div class="code-visual">
                    <svg width="100%" height="100%" viewBox="0 0 500 500">
                        <!-- Factory Conveyor Belt -->
                        <rect x="50" y="250" width="400" height="20" fill="#4ECDC4" opacity="0.3"/>
                        <rect x="50" y="270" width="400" height="10" fill="#FF6B35" opacity="0.5"/>
                        
                        <!-- Gears -->
                        <circle cx="100" cy="200" r="40" fill="none" stroke="#FFD93D" stroke-width="3" filter="url(#glow)">
                            <animateTransform attributeName="transform" type="rotate" from="0 100 200" to="360 100 200" dur="4s" repeatCount="indefinite"/>
                        </circle>
                        <circle cx="400" cy="200" r="40" fill="none" stroke="#FFD93D" stroke-width="3" filter="url(#glow)">
                            <animateTransform attributeName="transform" type="rotate" from="360 400 200" to="0 400 200" dur="4s" repeatCount="indefinite"/>
                        </circle>
                        
                        <!-- Data Boxes Moving -->
                        <rect x="80" y="240" width="30" height="30" fill="#FF6B35" opacity="0.8">
                            <animate attributeName="x" from="80" to="400" dur="5s" repeatCount="indefinite"/>
                        </rect>
                        <rect x="20" y="240" width="30" height="30" fill="#4ECDC4" opacity="0.8">
                            <animate attributeName="x" from="20" to="400" dur="6s" repeatCount="indefinite"/>
                        </rect>
                        
                        <!-- Analytics Chart -->
                        <polyline points="100,400 150,350 200,370 250,320 300,340 350,300 400,280" 
                                  fill="none" stroke="#4ECDC4" stroke-width="3" filter="url(#glow)">
                            <animate attributeName="stroke-dasharray" values="0,1000;1000,0" dur="3s" repeatCount="indefinite"/>
                        </polyline>
                    </svg>
                </div>
                
                <div>
                    <div class="card">
                        <h3>The Problem: You're Flying Blind</h3>
                        <p>Quick question: which marketing channel drove your last 3 deals? If you can't answer that in 5 seconds, you're guessing. And guessing is expensive.</p>
                    </div>
                    
                    <div class="card">
                        <h3 style="color: var(--secondary);">The Solution: Total Revenue Visibility</h3>
                        <p>We implement server-side tracking that survives iOS updates and ad blockers. You'll know exactly which dollar of ad spend generated which dollar of revenue.</p>
                        <ul>
                            <li><strong>Server-Side Tracking</strong> - Bulletproof data</li>
                            <li><strong>Multi-Touch Attribution</strong> - Full customer journey</li>
                            <li><strong>Live Dashboards</strong> - Real-time revenue data</li>
                            <li><strong>Conversion API</strong> - Feed clean data to platforms</li>
                        </ul>
                    </div>
                    
                    <div class="card testimonial">
                        <p>"We discovered LinkedIn was driving 60% of our revenue despite only getting 10% of our ad spend. Reallocated budget and 3x'd ROI in 90 days." - Agency Owner, $4M ARR</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Service 5: Content -->
    <section class="section">
        <div class="container">
            <div class="service-header">
                <h2>The Authority Engine</h2>
                <p class="service-price">$4,000<span class="price-sub">/month</span></p>
            </div>
            
            <div class="service-grid">
                <div>
                    <div class="card">
                        <h3>The Problem: You're Invisible Where It Matters</h3>
                        <p>Your buyers are on LinkedIn. Your competitors are on LinkedIn. Everyone's posting. But you? You're too busy running your business to "build a personal brand."</p>
                    </div>
                    
                    <div class="card">
                        <h3 style="color: var(--secondary);">The Solution: Omnipresent Authority</h3>
