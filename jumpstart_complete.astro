    <script>
        // 3D Geometric Shapes Background
        const canvas = document.getElementById('particles-canvas');
        const ctx = canvas.getContext('2d');
        
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        
        const shapes = [];
        const shapeCount = 15;
        
        class Shape3D {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 60 + 40;
                this.rotation = Math.random() * Math.PI * 2;
                this.rotationSpeed = (Math.random() - 0.5) * 0.02;
                this.vx = (Math.random() - 0.5) * 0.3;
                this.vy = (Math.random() - 0.5) * 0.3;
                this.type = Math.random() > 0.5 ? 'cube' : 'pyramid';
            }
            
            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.rotation += this.rotationSpeed;
                
                if (this.x < -this.size || this.x > canvas.width + this.size) this.vx *= -1;
                if (this.y < -this.size || this.y > canvas.height + this.size) this.vy *= -1;
            }
            
            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation);
                
                if (this.type === 'cube') {
                    this.drawCube();
                } else {
                    this.drawPyramid();
                }
                
                ctx.restore();
            }
            
            drawCube() {
                const s = this.size / 2;
                ctx.fillStyle = 'rgba(255, 215, 0, 0.1)';
                ctx.strokeStyle = 'rgba(255, 215, 0, 0.3)';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.rect(-s, -s, this.size, this.size);
                ctx.fill();
                ctx.stroke();
                
                ctx.fillStyle = 'rgba(255, 215, 0, 0.05)';
                ctx.beginPath();
                ctx.moveTo(-s, -s);
                ctx.lineTo(0, -s - s/2);
                ctx.lineTo(s, -s);
                ctx.lineTo(s, -s);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();
                
                ctx.fillStyle = 'rgba(255, 215, 0, 0.08)';
                ctx.beginPath();
                ctx.moveTo(s, -s);
                ctx.lineTo(s + s/2, 0);
                ctx.lineTo(s + s/2, this.size);
                ctx.lineTo(s, s);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();
            }
            
            drawPyramid() {
                const s = this.size / 2;
                ctx.fillStyle = 'rgba(255, 215, 0, 0.1)';
                ctx.strokeStyle = 'rgba(255, 215, 0, 0.3)';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(-s, s);
                ctx.lineTo(s, s);
                ctx.lineTo(s/2, 0);
                ctx.lineTo(-s/2, 0);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();
                
                ctx.fillStyle = 'rgba(255, 215, 0, 0.08)';
                ctx.beginPath();
                ctx.moveTo(-s, s);
                ctx.lineTo(0, -s);
                ctx.lineTo(s, s);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();
            }
        }
        
        for (let i = 0; i < shapeCount; i++) {
            shapes.push(new Shape3D());
        }
        
        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            shapes.forEach(shape => {
                shape.update();
                shape.draw();
            });
            requestAnimationFrame(animate);
        }
        
        animate();
        
        window.addEventListener('resize', () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        });

        // Survey Navigation
        let currentStep = 1;
        const totalSteps = 4;

        window.nextStep = function() {
            if (currentStep < totalSteps) {
                document.querySelector(`[data-step="${currentStep}"]`).style.display = 'none';
                currentStep++;
                document.querySelector(`[data-step="${currentStep}"]`).style.display = 'block';
                document.getElementById('progressFill').style.width = `${(currentStep / totalSteps) * 100}%`;
            }
        };

        window.prevStep = function() {
            if (currentStep > 1) {
                document.querySelector(`[data-step="${currentStep}"]`).style.display = 'none';
                currentStep--;
                document.querySelector(`[data-step="${currentStep}"]`).style.display = 'block';
                document.getElementById('progressFill').style.width = `${(currentStep / totalSteps) * 100}%`;
            }
        };

        // Form Submission
        document.getElementById('surveyForm').addEventListener('submit', (e) => {
            e.preventDefault();
            document.querySelector('#surveyForm').style.display = 'none';
            document.querySelector('#successMessage').style.display = 'block';
            
            // Send to both webhooks
            const webhooks = [
                "https://n8n.jumpstartscaling.com/webhook/2aadbf03-cff5-48b7-8236-cf344d755ed0",
                "https://n8n.jumpstartscaling.com/webhook-test/2aadbf03-cff5-48b7-8236-cf344d755ed0"
            ];
            webhooks.forEach(url => fetch(url, { method: "POST", body: new FormData(e.target) }));

            // GTM Data Layer
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
                "event": "form_submission",
                "formType": "scaling_survey",
                "conversionValue": 50
            });
        });

        // Active Nav Link on Scroll
        window.addEventListener('scroll', () => {
            const sections = ['ads', 'funnels', 'crm', 'analytics', 'content', 'retainer'];
            const scrollPos = window.scrollY + 100;

            sections.forEach(id => {
                const section = document.getElementById(id);
                if (section) {
                    const sectionTop = section.offsetTop;
                    const sectionHeight = section.offsetHeight;
                    if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
                        document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
                        const activeLink = document.querySelector(`.nav-links a[href="#${id}"]`);
                        if(activeLink) activeLink.classList.add('active');
                    }
                }
            });
        });
    </script>

