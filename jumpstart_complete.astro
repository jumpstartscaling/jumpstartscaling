---
import SEOTags from '../components/SEOTags.astro';
import GTMTracking from '../components/GTMTracking.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

const title = 'Jumpstart Scaling - Break Through The 7-Figure Ceiling';
const description = 'The proven methodology that helped 500+ founders automate operations, reclaim 20 hours a week, and build a valuation-ready asset in 90 days.';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <SEOTags title={title} description={description} />
    <SchemaOrg />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --gold: #FFD700;
            --gold-dark: #FFA500;
            --black: #000000;
            --dark: #0a0a0a;
            --dark-card: #111111;
            --text: #ffffff;
            --text-muted: #cccccc;
        }
        
        html { scroll-behavior: smooth; scroll-padding-top: 80px; }
        
        body {
            font-family: 'Inter', sans-serif;
            background: var(--black);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
            position: relative;
        }
        
        /* Interactive Background */
        #particles-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }
        
        .container { 
            max-width: 1400px; 
            margin: 0 auto; 
            padding: 0 2rem; 
            position: relative; 
            z-index: 1; 
        }
        
        /* Sticky Navigation */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 215, 0, 0.2);
            padding: 1rem 0;
        }
        
        .nav-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-size: 1.5rem;
            font-weight: 900;
            color: var(--gold);
            text-decoration: none;
        }
        
        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
            list-style: none;
        }
        
        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s;
            font-size: 0.9rem;
        }
        
        .nav-links a:hover,
        .nav-links a.active {
            color: var(--gold);
        }
        
        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            position: relative;
            padding-top: 80px;
        }
        
        .hero h1 {
            font-size: clamp(3rem, 8vw, 6.5rem);
            font-weight: 900;
            margin-bottom: 2rem;
            color: var(--text);
            letter-spacing: -0.02em;
        }
        
        .hero h1 .gold {
            color: var(--gold);
        }
        
        .hero .subtitle {
            font-size: clamp(1.2rem, 3vw, 1.8rem);
            color: var(--text-muted);
            max-width: 900px;
            margin: 0 auto 3rem;
            font-weight: 400;
        }
        
        .cta-primary {
            background: linear-gradient(135deg, var(--gold), var(--gold-dark));
            color: var(--black);
            padding: 1.5rem 4rem;
            font-size: 1.3rem;
            font-weight: 800;
            border-radius: 0;
            text-decoration: none;
            display: inline-block;
            border: none;
            transition: all 0.3s ease;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        
        .cta-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 40px rgba(255, 215, 0, 0.4);
        }
        
        /* Service Section */
        .section {
            padding: 8rem 0;
            position: relative;
        }
        
        .service-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5rem;
            align-items: center;
            max-width: 1300px;
            margin: 0 auto;
        }
        
        .service-header {
            text-align: center;
            margin-bottom: 5rem;
        }
        
        .service-header h2 {
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            font-weight: 900;
            margin-bottom: 1rem;
            color: var(--gold);
            letter-spacing: -0.02em;
        }
        
        .service-price {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--text);
        }
        
        .price-sub {
            font-size: 1.2rem;
            color: var(--text-muted);
            font-weight: 400;
        }
        
        /* Premium Cards */
        .card {
            background: var(--dark-card);
            border: 1px solid rgba(255, 215, 0, 0.2);
            padding: 3rem;
            margin-bottom: 2rem;
            position: relative;
            transition: all 0.3s ease;
        }
        
        .card:hover {
            border-color: var(--gold);
            transform: translateY(-5px);
        }
        
        .card h3 {
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            color: var(--text);
            font-weight: 700;
            letter-spacing: -0.01em;
        }
        
        .card p {
            color: var(--text-muted);
            line-height: 1.8;
            font-size: 1.1rem;
            font-weight: 400;
        }
        
        .card ul {
            list-style: none;
            margin-top: 2rem;
        }
        
        .card li {
            color: var(--text-muted);
            margin-bottom: 1.2rem;
            padding-left: 2rem;
            position: relative;
            font-size: 1.1rem;
            font-weight: 400;
        }
        
        .card li::before {
            content: '→';
            color: var(--gold);
            position: absolute;
            left: 0;
            font-weight: bold;
            font-size: 1.5rem;
        }
        
        .card li strong {
            color: var(--text);
            font-weight: 600;
        }
        
        .testimonial {
            background: rgba(255, 215, 0, 0.05);
            border-color: var(--gold);
            font-style: italic;
        }
        
        .testimonial p {
            color: var(--text);
            font-size: 1.15rem;
        }
        
        /* Code Visual Containers */
        .code-visual {
            width: 100%;
            height: 500px;
            position: relative;
            overflow: hidden;
            background: var(--dark-card);
            border: 1px solid rgba(255, 215, 0, 0.3);
        }
        
        /* Survey Styles */
        .survey-container {
            max-width: 700px;
            margin: 0 auto;
            background: var(--dark-card);
            padding: 4rem;
            border: 1px solid rgba(255, 215, 0, 0.2);
        }
        
        .survey-question {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 2rem;
            color: var(--gold);
        }
        
        .options-grid {
            display: grid;
            gap: 1rem;
        }
        
        .option-card {
            background: rgba(0,0,0,0.3);
            border: 2px solid rgba(255,255,255,0.1);
            padding: 1.5rem;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .option-card:hover {
            border-color: var(--gold);
        }
        
        .option-card input[type="radio"],
        .option-card input[type="checkbox"] {
            width: 20px;
            height: 20px;
        }
        
        .option-text {
            font-size: 1.1rem;
            color: var(--text);
        }
        
        .progress-container {
            width: 100%;
            height: 8px;
            background: rgba(255,255,255,0.1);
            margin-bottom: 3rem;
        }
        
        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, var(--gold), var(--gold-dark));
            width: 25%;
            transition: width 0.3s;
        }
        
        /* Footer */
        footer {
            padding: 4rem 0;
            border-top: 1px solid rgba(255, 215, 0, 0.2);
            text-align: center;
            color: var(--text-muted);
            margin-top: 8rem;
        }
        
        footer a {
            color: var(--text-muted);
            text-decoration: none;
            margin: 0 1.5rem;
            transition: color 0.3s;
            font-weight: 500;
        }
        
        footer a:hover {
            color: var(--gold);
        }
        
        @media(max-width: 968px) {
            .service-grid {
                grid-template-columns: 1fr;
                gap: 3rem;
            }
            .section {
                padding: 5rem 0;
            }
            .card, .survey-container {
                padding: 2rem;
            }
            .nav-links {
                display: none;
            }
        }
    </style>
</head>
<body>
    <canvas id="particles-canvas"></canvas>

    <!-- Sticky Navigation -->
    <nav>
        <div class="nav-container">
            <a href="#" class="logo">Jumpstart</a>
            <ul class="nav-links">
                <li><a href="#ads">Ads</a></li>
                <li><a href="#funnels">Funnels</a></li>
                <li><a href="#crm">CRM</a></li>
                <li><a href="#analytics">Analytics</a></li>
                <li><a href="#content">Content</a></li>
                <li><a href="#retainer">Retainer</a></li>
                <li><a href="#survey" class="cta-primary" style="padding: 0.75rem 2rem; font-size: 0.9rem;">Apply Now</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
        <div class="container">
            <h1>Scale From 7 to 8 Figures<br><span class="gold">Without The Burnout</span></h1>
            <p class="subtitle">
                The Jumpstart Methodology: Automate operations, install self-managing teams, 
                and build a valuation-ready asset in 90 days or less.
            </p>
            <a href="#survey" class="cta-primary">Get Your Free Scaling Blueprint</a>
        </div>
    </section>

    <!-- Service 1: Paid Ads -->
    <section class="section" id="ads">
        <div class="container">
            <div class="service-header">
                <h2>Paid Acquisition Engine</h2>
                <p class="service-price">$2,250<span class="price-sub">/month</span></p>
            </div>
            
            <div class="service-grid">
                <div>
                    <div class="card">
                        <h3>The Problem: You're Trapped in the Referral Hamster Wheel</h3>
                        <p>Referrals are great—until they're not. Your growth is completely at the mercy of your existing client's schedules and moods. One bad quarter? Your pipeline dries up. You can't forecast. You can't plan hires.</p>
                    </div>
                    
                    <div class="card">
                        <h3>The Solution: A Predictable Lead Machine</h3>
                        <p>We build and manage a self-sustaining acquisition system that turns $1 into $5. Every day, we're optimizing your ad spend, killing underperformers, and scaling winners.</p>
                        <ul>
                            <li><strong>Daily Ads Management</strong> - We monitor performance hourly, not monthly</li>
                            <li><strong>Creative Testing</strong> - New ad angles every week to beat fatigue</li>
                            <li><strong>Multi-Platform Scaling</strong> - Google, Facebook, LinkedIn</li>
                            <li><strong>ROI Dashboards</strong> - Real-time tracking</li>
                        </ul>
                    </div>
                    
                    <div class="card testimonial">
                        <p>"We went from 2-3 inbound leads per month to 40+ qualified SQLs. For the first time in 5 years, I can actually forecast revenue." - Agency Owner, $2.8M ARR</p>
                    </div>
                    
                    <a href="#survey" class="cta-primary" style="margin-top: 1rem;">Start With Paid Ads →</a>
                </div>
                
                <div class="code-visual">
                    <svg width="100%" height="100%" viewBox="0 0 500 500">
                        <defs>
                            <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#FFD700;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#FFA500;stop-opacity:1" />
                            </linearGradient>
                        </defs>
                        <ellipse cx="250" cy="300" rx="40" ry="80" fill="url(#goldGrad)">
                            <animateTransform attributeName="transform" type="translate" values="0 0; 0 -10; 0 0" dur="2s" repeatCount="indefinite"/>
                        </ellipse>
                        <polygon points="250,200 220,250 280,250" fill="#FFD700">
                            <animateTransform attributeName="transform" type="translate" values="0 0; 0 -10; 0 0" dur="2s" repeatCount="indefinite"/>
                        </polygon>
                        <ellipse cx="250" cy="380" rx="30" ry="40" fill="#FFA500" opacity="0.8">
                            <animate attributeName="ry" values="40;50;40" dur="0.5s" repeatCount="indefinite"/>
                        </ellipse>
                        <path d="M 50 450 L 450 50" stroke="#FFD700" stroke-width="3" fill="none" stroke-dasharray="10,5" opacity="0.5">
                            <animate attributeName="stroke-dashoffset" from="0" to="30" dur="2s" repeatCount="indefinite"/>
                        </path>
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <!-- Service 2: Funnels -->
    <section class="section" id="funnels">
        <div class="container">
            <div class="service-header">
                <h2>Funnel Architecture</h2>
                <p class="service-price">$3,500<span class="price-sub">/project</span></p>
            </div>
            
            <div class="service-grid">
                <div class="code-visual">
                    <svg width="100%" height="100%" viewBox="0 0 500 500">
                        <defs>
                            <linearGradient id="funnelGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" style="stop-color:#FFD700;stop-opacity:0.8" />
                                <stop offset="100%" style="stop-color:#FFA500;stop-opacity:1" />
                            </linearGradient>
                        </defs>
                        <path d="M 100 100 L 400 100 L 300 400 L 200 400 Z" fill="url(#funnelGrad)" opacity="0.7"/>
                        <line x1="120" y1="180" x2="380" y2="180" stroke="#FFD700" stroke-width="2"/>
                        <line x1="160" y1="260" x2="340" y2="260" stroke="#FFD700" stroke-width="2"/>
                        <line x1="200" y1="340" x2="300" y2="340" stroke="#FFD700" stroke-width="2"/>
                        <text x="420" y="140" fill="#FFD700" font-size="16" font-weight="bold">100%</text>
                        <text x="420" y="220" fill="#FFD700" font-size="16" font-weight="bold">40%</text>
                        <text x="420" y="300" fill="#FFD700" font-size="16" font-weight="bold">15%</text>
                        <circle cx="250" cy="120" r="4" fill="#FFD700">
                            <animate attributeName="cy" from="120" to="380" dur="3s" repeatCount="indefinite"/>
                            <animate attributeName="opacity" values="1;0" dur="3s" repeatCount="indefinite"/>
                        </circle>
                    </svg>
                </div>
                
                <div>
                    <div class="card">
                        <h3>The Problem: Traffic Doesn't Equal Revenue</h3>
                        <p>You're driving traffic to your site. People are clicking. And then... nothing. They bounce. They ghost. Your sales team is stuck chasing lukewarm leads who "need to think about it."</p>
                    </div>
                    
                    <div class="card">
                        <h3>The Solution: A Funnel That Qualifies & Converts</h3>
                        <p>We design, build, and optimize complete sales funnels that do the heavy lifting for you. From the first ad click to the booked call, every step is optimized.</p>
                        <ul>
                            <li><strong>Conversion Copywriting</strong> - Psychology-backed messaging</li>
                            <li><strong>UX/UI Design</strong> - Clean, fast, mobile-optimized</li>
                            <li><strong>Technical Integration</strong> - CRM, email, SMS, Calendly</li>
                            <li><strong>A/B Testing</strong> - Continuous optimization</li>
                        </ul>
                    </div>
                    
                    <div class="card testimonial">
                        <p>"Our funnel went from 8% conversion to 31% in 60 days. Same traffic, 4x the bookings." - SaaS Founder, $1.2M ARR</p>
                    </div>
                    
                    <a href="#survey" class="cta-primary" style="margin-top: 1rem;">Build My Funnel →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Service 3: CRM -->
    <section class="section" id="crm">
        <div class="container">
            <div class="service-header">
                <h2>CRM Transformation</h2>
                <p class="service-price">$2,500<span class="price-sub">/setup</span></p>
            </div>
            
            <div class="service-grid">
                <div>
                    <div class="card">
                        <h3>The Problem: Your CRM is a Digital Junk Drawer</h3>
                        <p>Be honest: when was the last time your CRM actually helped you close a deal? Right now, it's just a contact graveyard. Leads fall through the cracks. Your team forgets to follow up.</p>
                    </div>
                    
                    <div class="card">
                        <h3>The Solution: A Self-Driving CRM</h3>
                        <p>We turn your CRM from a glorified Rolodex into a revenue machine. Leads are automatically enriched, scored, and routed. Follow-ups happen on autopilot.</p>
                        <ul>
                            <li><strong>Custom Pipelines</strong> - Stages that match your process</li>
                            <li><strong>Auto-Follow Up</strong> - Email & SMS sequences</li>
                            <li><strong>Contract Automation</strong> - Proposals sent automatically</li>
                            <li><strong>Lead Scoring</strong> - AI-powered prioritization</li>
                        </ul>
                    </div>
                    
                    <div class="card testimonial">
                        <p>"We cut our sales cycle from 45 days to 18 days. Our close rate doubled." - B2B SaaS VP of Sales</p>
                    </div>
                    
                    <a href="#survey" class="cta-primary" style="margin-top: 1rem;">Fix My CRM →</a>
                </div>
                
                <div class="code-visual">
                    <svg width="100%" height="100%" viewBox="0 0 500 500">
                        <rect x="180" y="50" width="140" height="60" rx="0" fill="none" stroke="#FFD700" stroke-width="2"/>
                        <text x="250" y="85" text-anchor="middle" fill="#FFD700" font-size="14" font-weight="bold">New Lead</text>
                        <rect x="180" y="150" width="140" height="60" rx="0" fill="none" stroke="#FFD700" stroke-width="2"/>
                        <text x="250" y="185" text-anchor="middle" fill="#FFD700" font-size="14" font-weight="bold">CRM Entry</text>
                        <rect x="180" y="250" width="140" height="60" rx="0" fill="none" stroke="#FFD700" stroke-width="2"/>
                        <text x="250" y="285" text-anchor="middle" fill="#FFD700" font-size="14" font-weight="bold">Email Sequence</text>
                        <rect x="50" y="370" width="140" height="60" rx="0" fill="none" stroke="#FFA500" stroke-width="2"/>
                        <text x="120" y="405" text-anchor="middle" fill="#FFA500" font-size="14" font-weight="bold">Update</text>
                        <rect x="310" y="370" width="140" height="60" rx="0" fill="none" stroke="#FFD700" stroke-width="2"/>
                        <text x="380" y="405" text-anchor="middle" fill="#FFD700" font-size="14" font-weight="bold">Close Deal</text>
                        <path d="M 250 110 L 250 150" stroke="#FFD700" stroke-width="2">
                            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="2s" repeatCount="indefinite"/>
                        </path>
                        <path d="M 250 210 L 250 250" stroke="#FFD700" stroke-width="2">
                            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="2s" begin="0.5s" repeatCount="indefinite"/>
                        </path>
                        <path d="M 250 310 L 120 370" stroke="#FFA500" stroke-width="2">
                            <animate attributeName="stroke-dasharray" values="0,200;200,0" dur="2s" begin="1s" repeatCount="indefinite"/>
                        </path>
                        <path d="M 250 310 L 380 370" stroke="#FFD700" stroke-width="2">
                            <animate attributeName="stroke-dasharray" values="0,200;200,0" dur="2s" begin="1s" repeatCount="indefinite"/>
                        </path>
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <!-- Service 4: Analytics -->
    <section class="section" id="analytics">
        <div class="container">
            <div class="service-header">
                <h2>Data & Attribution</h2>
                <p class="service-price">$1,500<span class="price-sub">/month</span></p>
            </div>
            
            <div class="service-grid">
                <div class="code-visual">
                    <svg width="100%" height="100%" viewBox="0 0 500 500">
                        <rect x="50" y="250" width="400" height="20" fill="#FFD700" opacity="0.3"/>
                        <circle cx="100" cy="200" r="40" fill="none" stroke="#FFD700" stroke-width="3">
                            <animateTransform attributeName="transform" type="rotate" from="0 100 200" to="360 100 200" dur="4s" repeatCount="indefinite"/>
                        </circle>
                        <circle cx="400" cy="200" r="40" fill="none" stroke="#FFD700" stroke-width="3">
                            <animateTransform attributeName="transform" type="rotate" from="360 400 200" to="0 400 200" dur="4s" repeatCount="indefinite"/>
                        </circle>
                        <rect x="80" y="240" width="30" height="30" fill="#FFD700" opacity="0.8">
                            <animate attributeName="x" from="80" to="400" dur="5s" repeatCount="indefinite"/>
                        </rect>
                        <polyline points="100,400 150,350 200,370 250,320 300,340 350,300 400,280" 
                                  fill="none" stroke="#FFD700" stroke-width="3">
                            <animate attributeName="stroke-dasharray" values="0,1000;1000,0" dur="3s" repeatCount="indefinite"/>
                        </polyline>
                    </svg>
                </div>
                
                <div>
                    <div class="card">
                        <h3>The Problem: You're Flying Blind</h3>
                        <p>Quick question: which marketing channel drove your last 3 deals? If you can't answer that in 5 seconds, you're guessing. And guessing is expensive.</p>
                    </div>
                    
                    <div class="card">
                        <h3>The Solution: Total Revenue Visibility</h3>
                        <p>We implement server-side tracking that survives iOS updates and ad blockers. You'll know exactly which dollar of ad spend generated which dollar of revenue.</p>
                        <ul>
                            <li><strong>Server-Side Tracking</strong> - Bulletproof data</li>
                            <li><strong>Multi-Touch Attribution</strong> - Full customer journey</li>
                            <li><strong>Live Dashboards</strong> - Real-time revenue data</li>
                            <li><strong>Conversion API</strong> - Feed clean data to platforms</li>
                        </ul>
                    </div>
                    
                    <div class="card testimonial">
                        <p>"We discovered LinkedIn was driving 60% of our revenue despite only getting 10% of our ad spend. Reallocated budget and 3x'd ROI in 90 days." - Agency Owner, $4M ARR</p>
                    </div>
                    
                    <a href="#survey" class="cta-primary" style="margin-top: 1rem;">Get Data Clarity →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Service 5: Content -->
    <section class="section" id="content">
        <div class="container">
            <div class="service-header">
                <h2>The Authority Engine</h2>
                <p class="service-price">$4,000<span class="price-sub">/month</span></p>
            </div>
            
            <div class="service-grid">
                <div>
                    <div class="card">
                        <h3>The Problem: You're Invisible Where It Matters</h3>
                        <p>Your buyers are on LinkedIn. Your competitors are on LinkedIn. Everyone's posting. But you? You're too busy running your business to "build a personal brand."</p>
                    </div>
                    
                    <div class="card">
                        <h3>The Solution: Omnipresent Authority</h3>
                        <p>We handle the entire content engine. You record one 30-minute Loom per week. We turn it into 50+ assets: LinkedIn posts, newsletter issues, video clips, Twitter threads.</p>
                        <ul>
                            <li><strong>LinkedIn Ghostwriting</strong> - Daily posts that sound like you</li>
                            <li><strong>Newsletter Operations</strong> - Weekly emails that nurture</li>
                            <li><strong>Video Repurposing</strong> - Turn one video into 20 clips</li>
