---
/**
 * CosmicHero.astro
 * 
 * Interstellar-themed hero section with:
 * - Warp speed starfield effect
 * - Holographic HUD elements
 * - "Launch" aesthetic
 */

interface Props {
  title: string;
  subtitle: string;
  primaryCTA: { text: string; href: string; };
  secondaryCTA?: { text: string; href: string; };
}

const { title, subtitle, primaryCTA, secondaryCTA } = Astro.props;
---

<section class="relative min-h-screen w-full bg-[#050505] overflow-hidden flex flex-col justify-center items-center text-center pt-20">
  
  <!-- BACKGROUND LAYERS -->
  
  <!-- 1. Deep Space Gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-black via-[#0a0f1e] to-black z-0"></div>
  
  <!-- 2. Animated Starfield (CSS Stars) -->
  <div class="stars absolute inset-0 z-0"></div>
  <div class="stars2 absolute inset-0 z-0"></div>
  
  <!-- 3. Grid Horizon (Retro/Synthwave style but clean) -->
  <div class="absolute bottom-0 left-0 right-0 h-[50vh] bg-gradient-to-t from-gold-900/10 to-transparent z-0 transform perspective-500 rotate-x-60">
    <div class="w-full h-full bg-grid-pattern opacity-20 animate-grid-flow"></div>
  </div>

  <!-- 4. Nebula Glows -->
  <div class="absolute top-[20%] left-[20%] w-[30vw] h-[30vw] bg-blue-900/10 rounded-full blur-[100px] animate-pulse-slow"></div>
  <div class="absolute bottom-[20%] right-[20%] w-[30vw] h-[30vw] bg-gold-600/10 rounded-full blur-[100px] animate-pulse-slow" style="animation-delay: 2s"></div>

  <!-- CONTENT HUD -->
  <div class="relative z-10 container mx-auto px-4">
    
    <!-- System Status Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-8 animate-fade-in-down">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
      </span>
      <span class="text-xs font-mono text-gray-300 tracking-widest uppercase">Systems Nominal</span>
    </div>

    <!-- Main Title -->
    <div class="max-w-5xl mx-auto mb-8">
      <h1 class="text-6xl md:text-8xl font-black tracking-tight text-white mb-2 leading-tight drop-shadow-[0_0_15px_rgba(255,255,255,0.3)]">
        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-200 to-gray-400 animate-gradient-x">
          {title}
        </span>
      </h1>
      <!-- Glowing underline/bar -->
      <div class="h-1 w-24 mx-auto bg-gradient-to-r from-transparent via-gold-500 to-transparent rounded-full mb-6 shadow-[0_0_10px_#F59E0B]"></div>
    </div>

    <!-- Subtitle -->
    <p class="text-xl md:text-2xl text-gray-400 max-w-2xl mx-auto leading-relaxed mb-12 animate-fade-in-up">
      {subtitle}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col md:flex-row gap-6 justify-center items-center animate-fade-in-up" style="animation-delay: 0.2s">
      
      <!-- Primary CTA (Thruster Button) -->
      <a 
        href={primaryCTA.href} 
        class="group relative px-8 py-4 bg-white text-black rounded-full font-bold text-lg overflow-hidden transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(255,255,255,0.4)]"
      >
        <div class="absolute inset-0 bg-gradient-to-r from-gold-200 to-gold-400 opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <span class="relative flex items-center gap-2">
          {primaryCTA.text}
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
        </span>
      </a>

      {secondaryCTA && (
        <a 
          href={secondaryCTA.href} 
          class="px-8 py-4 text-white rounded-full font-medium border border-white/10 hover:bg-white/5 transition-all backdrop-blur-sm"
        >
          {secondaryCTA.text}
        </a>
      )}
    </div>
  </div>

  <!-- SCROLL INDICATOR -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 animate-bounce">
    <div class="w-[1px] h-12 bg-gradient-to-b from-transparent to-white"></div>
    <span class="text-[10px] uppercase tracking-[0.2em] text-gray-500">Initialize</span>
  </div>

</section>

<style>
  /* Star Animation */
  .stars {
    width: 1px;
    height: 1px;
    background: transparent;
    box-shadow: 1744px 122px #FFF , 134px 1321px #FFF , 92px 859px #FFF; /* Simplified for brevity, normally generated */
    animation: animStar 50s linear infinite;
  }
  .stars2 {
    width: 2px;
    height: 2px;
    background: transparent;
    box-shadow: 200px 300px #FFF , 400px 100px #FFF;
    animation: animStar 100s linear infinite;
  }
  
  @keyframes animStar {
    from { transform: translateY(0px); }
    to { transform: translateY(-2000px); }
  }

  /* Grid Flow */
  @keyframes grid-flow {
    0% { background-position: 0 0; }
    100% { background-position: 0 40px; }
  }
  .animate-grid-flow {
    background-size: 40px 40px;
    background-image: linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
                      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    animation: grid-flow 2s linear infinite;
  }
  
  .perspective-500 { perspective: 500px; }
  .rotate-x-60 { transform: rotateX(60deg); }
</style>
