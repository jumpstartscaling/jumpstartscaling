---
/**
 * TechHero.astro
 * 
 * High-tech hero section with:
 * - Shooting star background beams
 * - Terminal window code display
 * - "No Portfolio needed" approach
 */

import TerminalWindow from './TerminalWindow.astro';

interface Props {
  title: string;
  subtitle: string;
  primaryCTA: { text: string; href: string; };
  codeSnippet: string[];
}

const { title, subtitle, primaryCTA, codeSnippet } = Astro.props;
---

<section class="relative min-h-screen w-full bg-black overflow-hidden flex flex-col justify-center pt-20">
  <!-- Background Effects -->
  <div class="absolute inset-0 bg-grid-pattern opacity-[0.03]"></div>
  
  <!-- Shooting Stars / Beams -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="beam-1 absolute top-0 left-[20%] w-[1px] h-screen bg-gradient-to-b from-transparent via-gold-500/50 to-transparent opacity-0"></div>
    <div class="beam-2 absolute top-0 left-[60%] w-[1px] h-screen bg-gradient-to-b from-transparent via-gold-500/30 to-transparent opacity-0" style="animation-delay: 2s"></div>
    <div class="beam-3 absolute top-0 right-[10%] w-[1px] h-[150vh] bg-gradient-to-b from-transparent via-white/20 to-transparent opacity-0 rotate-45 transform origin-top-left" style="animation-delay: 1.5s"></div>
  </div>

  <div class="container mx-auto px-4 z-10 grid lg:grid-cols-2 gap-12 items-center">
    
    <!-- Left: Text Content -->
    <div class="text-left space-y-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-900/10 border border-gold-500/20 text-gold-400 text-xs font-mono mb-4 animate-fade-in">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        SYSTEM_ONLINE
      </div>
      
      <h1 class="text-5xl md:text-7xl font-black tracking-tight text-white leading-tight animate-fade-in-up">
        {title.split(' ').map((word, i) => (
          <span class={i < 2 ? "text-white" : "text-transparent bg-clip-text bg-gradient-to-r from-gold-300 to-gold-600"}>
            {word}{' '}
          </span>
        ))}
      </h1>
      
      <p class="text-xl text-gray-400 max-w-lg leading-relaxed animate-fade-in-up" style="animation-delay: 0.2s">
        {subtitle}
      </p>
      
      <div class="flex flex-wrap gap-4 pt-4 animate-fade-in-up" style="animation-delay: 0.4s">
        <a 
          href={primaryCTA.href} 
          class="group relative inline-flex items-center gap-3 px-8 py-4 bg-white text-black rounded-lg font-bold text-lg hover:bg-gold-50 transition-colors"
        >
          {primaryCTA.text}
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>
    </div>

    <!-- Right: Code Terminal -->
    <div class="relative lg:block animate-slide-in-right" style="animation-delay: 0.6s">
      <TerminalWindow 
        codeLines={codeSnippet}
        title="system_architecture.yml"
      />
      
      <!-- Decorator Elements -->
      <div class="absolute -z-10 top-[-20%] right-[-10%] w-[300px] h-[300px] bg-gold-600/10 rounded-full blur-[100px]"></div>
    </div>
  </div>
</section>

<style>
  @keyframes beam-drop {
    0% { transform: translateY(-100%); opacity: 0; }
    50% { opacity: 1; }
    100% { transform: translateY(100%); opacity: 0; }
  }
  
  .beam-1 { animation: beam-drop 7s infinite ease-in-out; }
  .beam-2 { animation: beam-drop 10s infinite ease-in-out 1s; }
  .beam-3 { animation: beam-drop 5s infinite linear; }
</style>
