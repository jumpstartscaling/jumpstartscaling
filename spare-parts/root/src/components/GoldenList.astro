---
/**
 * GoldenList.astro
 * List component with custom SVG icons (Checkmarks, Arrows, Lightning, etc.)
 */

interface Props {
  items: string[];
  iconType?: 'check' | 'arrow' | 'lightning' | 'circuit' | 'star' | 'server' | 'chart' | 'pen' | 'clock' | 'shield';
  cols?: 1 | 2;
}

const { items, iconType = 'check', cols = 1 } = Astro.props;

const gridClass = cols === 2 ? 'grid grid-cols-1 md:grid-cols-2 gap-4' : 'space-y-4';

// SVG Paths mapping
const icons = {
  check: "M5 13l4 4L19 7",
  arrow: "M13 7l5 5m0 0l-5 5m5-5H6",
  lightning: "M13 10V3L4 14h7v7l9-11h-7z",
  circuit: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z", // Simplified
  star: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z",
  server: "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2",
  chart: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
  pen: "M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z",
  clock: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  shield: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
};
---

<div class={gridClass}>
  {items.map((item) => (
    <div class="flex items-start gap-3 group">
      <div class="flex-shrink-0 mt-1 w-6 h-6 rounded-full bg-gold-900/20 flex items-center justify-center border border-gold-500/30 group-hover:border-gold-400 transition-colors">
        <svg class="w-3.5 h-3.5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[iconType]} />
        </svg>
      </div>
      <span class="text-gray-300 font-light leading-relaxed group-hover:text-white transition-colors" set:html={item}></span>
    </div>
  ))}
</div>
