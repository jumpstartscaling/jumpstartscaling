# God Mode + Directus Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# GOD MODE CONFIGURATION
# ============================================

# PostgreSQL Database URL (REQUIRED)
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# Redis URL (optional - defaults to local redis container)
# Example: redis://username:password@host:6379
REDIS_URL=redis://redis:6379

# God Mode API Authentication Token (REQUIRED)
# Generate with: openssl rand -base64 32
GOD_MODE_TOKEN=

# Node Environment
NODE_ENV=production

# ============================================
# DIRECTUS CMS CONFIGURATION
# ============================================

# Directus Public URL (update with your actual domain)
# Example: https://directus.yourdomain.com
DIRECTUS_PUBLIC_URL=http://localhost:8055

# Directus Security Keys (REQUIRED)
# Generate with: openssl rand -base64 32
DIRECTUS_KEY=
DIRECTUS_SECRET=

# Directus Admin User (first-time setup)
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=

# ============================================
# GENERATION COMMANDS
# ============================================
# Use these commands to generate secure random values:
#
# GOD_MODE_TOKEN:
#   openssl rand -base64 32
#
# DIRECTUS_KEY:
#   openssl rand -base64 32
#
# DIRECTUS_SECRET:
#   openssl rand -base64 32
#
# DIRECTUS_ADMIN_PASSWORD:
#   openssl rand -base64 16
