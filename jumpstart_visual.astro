---
import SEOTags from '../components/SEOTags.astro';
import GTMTracking from '../components/GTMTracking.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

const title = 'Jumpstart Scaling - Break Through The 7-Figure Ceiling';
const description = 'The proven methodology that helped 500+ founders automate operations, reclaim 20 hours a week, and build a valuation-ready asset in 90 days.';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <SEOTags title={title} description={description} />
    <SchemaOrg />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            /* Backgrounds */
            --bg-primary: #000000;
            --bg-secondary: #0A0A0A;
            --bg-deep: #050505;
            --bg-glass: rgba(255, 255, 255, 0.03);
            
            /* Accents */
            --gold-primary: #C9A961;
            --gold-bright: #E5C88D;
            --gold-dark: #9B7E46;
            
            /* The "Rolex" Metallic Gradient */
            --gold-metal: linear-gradient(135deg, #BF953F 0%, #FCF6BA 25%, #B38728 50%, #FBF5B7 75%, #AA771C 100%);
            
            /* Glows */
            --gold-glow: 0 0 20px rgba(191, 149, 63, 0.3);
            
            /* Typography */
            --text-main: #FFFFFF;
            --text-muted: #B8B8B8;
            
            /* Legacy aliases */
            --black: #000000;
            --dark-grey: #0A0A0A;
            --gold: #C9A961;
            --text: #FFFFFF;
        }
        
        html { scroll-behavior: smooth; scroll-padding-top: 80px; }
        
        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-deep);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        /* Golden Nebula Animated Background */
        #gradient-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            background-color: var(--bg-deep);
            overflow: hidden;
        }
        
        #gradient-bg::before,
        #gradient-bg::after {
            content: '';
            position: absolute;
            width: 60vw;
            height: 60vw;
            background: radial-gradient(circle, rgba(201, 169, 97, 0.08), transparent 70%);
            border-radius: 50%;
            animation: floatLight 15s infinite alternate ease-in-out;
        }
        
        #gradient-bg::before {
            top: -10%;
            left: -10%;
        }
        
        #gradient-bg::after {
            bottom: -10%;
            right: -10%;
            animation-delay: -7s;
            background: radial-gradient(circle, rgba(155, 126, 70, 0.08), transparent 70%);
        }
        
        @keyframes floatLight {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(50px, 50px) scale(1.1); }
        }
        
        .container { 
            max-width: 1400px; 
            margin: 0 auto; 
            padding: 0 2rem; 
            position: relative; 
            z-index: 2;
        }
        
        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(201, 169, 97, 0.1);
            padding: 1.25rem 0;
        }
        
        .nav-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-size: 1.5rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--gold-bright), var(--gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-decoration: none;
        }
        
        .nav-links {
            display: flex;
            gap: 2.5rem;
            align-items: center;
            list-style: none;
        }
        
        .nav-links a {
            color: var(--text);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s;
            font-size: 0.95rem;
        }
        
        .nav-links a:hover,
        .nav-links a.active {
            color: var(--gold-bright);
        }
        
        /* Hero */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding-top: 80px;
            position: relative;
            z-index: 1;
        }
        
        .hero h1 {
            font-size: clamp(2.5rem, 8vw, 7rem);
            font-weight: 900;
            margin-bottom: 2rem;
            letter-spacing: -0.02em;
            line-height: 1.1;
        }
        
        .hero h1 .gold {
            background: var(--gold-metal);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 2px 10px rgba(0,0,0,0.5));
        }
        
        .hero .subtitle {
            font-size: clamp(1.1rem, 2.5vw, 1.8rem);
            color: var(--text-muted);
            max-width: 900px;
            margin: 0 auto 3.5rem;
            font-weight: 400;
            line-height: 1.7;
        }
        
        .cta-primary {
            background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
            color: var(--black);
            padding: 1.75rem 4.5rem;
            font-size: 1.1rem;
            font-weight: 700;
            border-radius: 2px;
            text-decoration: none;
            display: inline-block;
            border: none;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            box-shadow: 0 4px 20px rgba(201, 169, 97, 0.2);
        }
        
        .cta-primary:hover {
            background: linear-gradient(135deg, var(--gold-bright), var(--gold-primary));
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(229, 200, 141, 0.4);
        }
        
        /* Section */
        .section {
            padding: 8rem 0;
            position: relative;
            z-index: 1;
        }
        
        section:nth-of-type(even) {
            background-color: var(--dark-grey);
            border-top: 1px solid rgba(255,255,255,0.03);
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }

        .section-title {
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            font-weight: 900;
            margin-bottom: 4rem;
            background: var(--gold-metal);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 2px 10px rgba(0,0,0,0.5));
            letter-spacing: -0.02em;
        }
        
        /* Side-by-Side Layout */
        .content-row {
            display: flex;
            flex-direction: row;
            gap: 6rem;
            align-items: center;
            margin-bottom: 4rem;
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .content-row > * {
            flex: 1;
        }

        .content-row.visible {
            opacity: 1;
            transform: translateY(0);
        }
        
        .content-row.reverse {
            flex-direction: row-reverse;
        }
        
        .content-text h3 {
            font-size: clamp(1.8rem, 3vw, 2.5rem);
            margin-bottom: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.2;
        }
        
        .content-text h3.gold {
            background: var(--gold-metal);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 2px 10px rgba(0,0,0,0.5));
        }
        
        .content-text p {
            color: var(--text-muted);
            line-height: 1.7;
            font-size: clamp(1.05rem, 1.5vw, 1.25rem);
            margin-bottom: 2rem;
        }
        
        .content-text ul {
            list-style: none;
            margin-top: 2rem;
        }
        
        .content-text li {
            color: var(--text);
            margin-bottom: 1.25rem;
            padding-left: 2rem;
            position: relative;
            font-size: 1.15rem;
            line-height: 1.6;
        }
        
        .content-text li::before {
            content: '→';
            color: var(--gold);
            position: absolute;
            left: 0;
            font-weight: bold;
            font-size: 1.5rem;
        }
        
        .content-text li strong {
            font-weight: 600;
            color: var(--gold-bright);
        }
        
        /* Visual Containers */
        .visual-3d {
            position: relative;
            min-height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
            perspective: 1000px;
        }
        
        .visual-3d canvas,
        .visual-3d svg {
            width: 100%;
            height: 100%;
            max-width: 500px;
        }
        
        /* Animations */
        @keyframes float { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-20px); } }
        @keyframes rotate3d { 0% { transform: rotateY(0deg); } 100% { transform: rotateY(360deg); } }
        @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
        @keyframes slideIn { 0% { left: -20%; } 100% { left: 120%; } }
        
        /* Survey */
        .survey-container {
            max-width: 750px;
            margin: 0 auto;
            background: var(--bg-glass);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 4.5rem;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }
        
        .survey-question {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 2.5rem;
            background: linear-gradient(135deg, var(--gold-bright), var(--gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .options-grid {
            display: grid;
            gap: 1.25rem;
        }
        
        .option-card {
            background: var(--bg-glass);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 1.75rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 1.25rem;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }
        
        .option-card:hover {
            border-color: #BF953F;
            background: rgba(191, 149, 63, 0.05);
            box-shadow: var(--gold-glow);
        }
        
        .option-card input {
            width: 20px;
            height: 20px;
            accent-color: var(--gold);
        }
        
        .option-text {
            font-size: 1.15rem;
            color: var(--text);
        }
        
        .progress-container {
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.1);
            margin-bottom: 3.5rem;
            border-radius: 3px;
            overflow: hidden;
        }
        
        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, var(--gold), var(--gold-bright));
            width: 25%;
            transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        footer {
            padding: 5rem 0;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            text-align: center;
            color: var(--text-muted);
            margin-top: 10rem;
            background-color: var(--black);
        }
        
        footer a {
            color: var(--text-muted);
            text-decoration: none;
            margin: 0 2rem;
            transition: color 0.3s;
        }
        
        footer a:hover {
            color: var(--gold);
        }
        
        /* Spotlight Effect */
        .spotlight-target {
            position: relative;
            overflow: hidden;
        }
        
        .spotlight-target::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(600px circle at var(--mouse-x) var(--mouse-y), rgba(201, 169, 97, 0.15), transparent 40%);
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
            z-index: 2;
        }
        
        .spotlight-target:hover::after {
            opacity: 1;
        }
        
        @media(max-width: 768px) {
            .content-row {
                flex-direction: column;
                gap: 3rem;
            }

            /* Text always on top for mobile */
            .content-row:not(.reverse) {
                flex-direction: column; 
            }
            
            .content-row.reverse {
                flex-direction: column-reverse;
            }

            /* Center align headings on mobile */
            .section-title,
            .content-text h3 {
                text-align: center;
            }

            /* Keep list items left-aligned */
            .content-text li {
                text-align: left;
                padding-left: 2rem;
            }

            .section { padding: 5rem 0; }
            .survey-container { padding: 2.5rem; }
            .nav-links { display: none; }
            .hero h1 { font-size: 3rem; }
        }
    </style>
</head>
<body>
    <div id="gradient-bg"></div>

    <nav>
        <div class="nav-container">
            <a href="#" class="logo">Jumpstart</a>
            <ul class="nav-links">
                <li><a href="#ads">Ads</a></li>
                <li><a href="#funnels">Funnels</a></li>
                <li><a href="#crm">CRM</a></li>
                <li><a href="#analytics">Analytics</a></li>
                <li><a href="#content">Content</a></li>
                <li><a href="#retainer">Team</a></li>
                <li><a href="#survey" class="cta-primary" style="padding: 0.875rem 2.5rem; font-size: 0.85rem;">Apply Now</a></li>
            </ul>
        </div>
    </nav>

    <section class="hero">
        <div class="container">
            <h1>Scale From 7 to 8 Figures<br><span class="gold">Without The Burnout</span></h1>
            <p class="subtitle">
                Stop Leaving Money on the Table. Systematize Your Growth. Remove The Guesswork.
            </p>
            <a href="#survey" class="cta-primary">Get Your Free Scaling Blueprint</a>
        </div>
    </section>

    <!-- Section 1: Paid Ads -->
    <section class="section" id="ads">
        <div class="container">
            <h2 class="section-title">Paid Acquisition Engine</h2>
            
            <div class="content-row">
                <div class="content-text">
                    <h3>You're Trapped in the Referral Hamster Wheel</h3>
                    <p>Your growth is completely at the mercy of your existing clients. One bad quarter? Your pipeline dries up. You can't forecast. You can't plan hires. You're constantly white-knuckling it, hoping someone sends business your way.</p>
                </div>
                <div class="visual-3d">
                    <canvas id="adsCanvas" width="500" height="400"></canvas>
                </div>
            </div>
            
            <div class="content-row reverse">
                <div class="visual-3d">
                    <svg viewBox="0 0 500 400" style="max-width: 500px;">
                        <defs>
                            <linearGradient id="goldGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#E5C88D" />
                                <stop offset="100%" style="stop-color:#9B7E46" />
                            </linearGradient>
                            <filter id="glow">
                                <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
                                <feMerge>
                                    <feMergeNode in="coloredBlur"/>
                                    <feMergeNode in="SourceGraphic"/>
                                </feMerge>
                            </filter>
                        </defs>
                        <circle cx="250" cy="200" r="120" fill="none" stroke="url(#goldGrad1)" stroke-width="2" opacity="0.3">
                            <animate attributeName="r" values="120;140;120" dur="4s" repeatCount="indefinite"/>
                        </circle>
                        <circle cx="250" cy="200" r="80" fill="none" stroke="url(#goldGrad1)" stroke-width="2" opacity="0.5">
                            <animate attributeName="r" values="80;100;80" dur="3s" repeatCount="indefinite"/>
                        </circle>
                        <circle cx="250" cy="200" r="40" fill="url(#goldGrad1)" filter="url(#glow)">
                            <animate attributeName="r" values="40;50;40" dur="2s" repeatCount="indefinite"/>
                        </circle>
                        <text x="250" y="210" text-anchor="middle" fill="#000" font-size="24" font-weight="bold">4.8x</text>
                        <text x="250" y="230" text-anchor="middle" fill="#000" font-size="10" font-weight="600">ROAS</text>
                    </svg>
                </div>
                <div class="content-text">
                    <h3 class="gold">Turn Cold Traffic Into Hyper-Active Buyers</h3>
                    <p>We build and manage a self-sustaining acquisition system that turns $1 into $5. Every day, we're optimizing your ad spend, killing underperformers, and scaling winners.</p>
                    <ul>
                        <li><strong>Daily Ads Management</strong> - We monitor performance hourly, not monthly</li>
                        <li><strong>Creative Testing</strong> - New ad angles every week to beat fatigue</li>
                        <li><strong>Multi-Platform Scaling</strong> - Google, Facebook, LinkedIn</li>
                        <li><strong>ROI Dashboards</strong> - Real-time tracking</li>
                    </ul>
                </div>
            </div>
            
            <div style="text-align: center; margin-top: 4rem;">
                <a href="#survey" class="cta-primary">Start With Paid Ads →</a>
            </div>
        </div>
    </section>

    <!-- Section 2: Funnels -->
    <section class="section" id="funnels">
        <div class="container">
            <h2 class="section-title">Funnel Architecture</h2>
            
            <div class="content-row">
                <div class="visual-3d">
                    <canvas id="funnelCanvas" width="500" height="400"></canvas>
                </div>
                <div class="content-text">
                    <h3>Traffic Doesn't Equal Revenue</h3>
                    <p>You're driving traffic to your site. People are clicking. And then... nothing. They bounce. They ghost. Your sales team is stuck chasing lukewarm leads who "need to think about it."</p>
                </div>
            </div>
            
            <div class="content-row reverse">
                <div class="content-text">
                    <h3 class="gold">Frictionless Lead Capture Architecture</h3>
                    <p>We design, build, and optimize complete sales funnels that do the heavy lifting for you. From the first ad click to the booked call, every step is optimized to filter out tire-kickers and fast-track serious buyers.</p>
                    <ul>
                        <li><strong>Conversion Copywriting</strong> - Psychology-backed messaging</li>
                        <li><strong>UX/UI Design</strong> - Clean, fast, mobile-optimized pages</li>
                        <li><strong>Technical Integration</strong> - CRM, email, SMS, Calendly</li>
                        <li><strong>A/B Testing Setup</strong> - Continuous optimization</li>
                    </ul>
                </div>
                <div class="visual-3d">
                    <svg viewBox="0 0 500 400" style="max-width: 500px;">
                        <defs>
                            <linearGradient id="funnelGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" style="stop-color:#E5C88D;stop-opacity:0.3" />
                                <stop offset="100%" style="stop-color:#C9A961;stop-opacity:0.8" />
                            </linearGradient>
                        </defs>
                        <path d="M 100 50 L 400 50 L 300 350 L 200 350 Z" fill="url(#funnelGrad)" stroke="#C9A961" stroke-width="2"/>
                        <line x1="120" y1="120" x2="380" y2="120" stroke="#C9A961" stroke-width="2" opacity="0.6"/>
                        <line x1="160" y1="200" x2="340" y2="200" stroke="#C9A961" stroke-width="2" opacity="0.6"/>
                        <line x1="200" y1="280" x2="300" y2="280" stroke="#C9A961" stroke-width="2" opacity="0.6"/>
                        <circle cx="250" cy="80" r="5" fill="#E5C88D">
                            <animate attributeName="cy" from="80" to="320" dur="3s" repeatCount="indefinite"/>
                            <animate attributeName="opacity" values="1;0" dur="3s" repeatCount="indefinite"/>
                        </circle>
                    </svg>
                </div>
            </div>
            
            <div style="text-align: center; margin-top: 4rem;">
                <a href="#survey" class="cta-primary">Build My Funnel →</a>
            </div>
        </div>
    </section>

    <!-- Section 3: CRM -->
    <section class="section" id="crm">
        <div class="container">
            <h2 class="section-title">CRM Transformation</h2>
            
            <div class="content-row">
                <div class="content-text">
                    <h3>Your CRM is a Digital Junk Drawer</h3>
                    <p>When was the last time your CRM actually helped you close a deal? Right now, it's just a contact graveyard. Leads fall through the cracks. Your team forgets to follow up.</p>
                </div>
                <div class="visual-3d">
                    <canvas id="crmCanvas" width="500" height="400"></canvas>
                </div>
            </div>
            
            <div class="content-row reverse">
                <div class="visual-3d">
                    <svg viewBox="0 0 500 400" style="max-width: 500px;">
                        <rect x="50" y="150" width="120" height="80" rx="8" fill="rgba(255,255,255,0.02)" stroke="#C9A961" stroke-width="2"/>
                        <text x="110" y="195" text-anchor="middle" fill="#C9A961" font-size="14">LEAD IN</text>
                        <rect x="250" y="150" width="120" height="80" rx="8" fill="rgba(201,169,97,0.1)" stroke="#C9A961" stroke-width="2"/>
                        <text x="310" y="195" text-anchor="middle" fill="#C9A961" font-size="14">PROCESS</text>
                        <rect x="450" y="150" width="120" height="80" rx="8" fill="url(#goldGrad1)" stroke="#E5C88D" stroke-width="2"/>
                        <text x="510" y="195" text-anchor="middle" fill="#000" font-size="14" font-weight="bold">CLOSED</text>
                        <path d="M 170 190 L 250 190" stroke="#C9A961" stroke-width="3" marker-end="url(#arrowhead)"/>
                        <path d="M 370 190 L 450 190" stroke="#C9A961" stroke-width="3" marker-end="url(#arrowhead)"/>
                        <defs>
                            <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
                                <polygon points="0 0, 10 3, 0 6" fill="#C9A961" />
                            </marker>
                        </defs>
                        <circle cx="210" cy="190" r="8" fill="#E5C88D">
                            <animate attributeName="cx" from="170" to="450" dur="4s" repeatCount="indefinite"/>
                        </circle>
                    </svg>
                </div>
                <div class="content-text">
                    <h3 class="gold">From 'Feast or Famine' To Predictable Scale</h3>
                    <p>We turn your CRM from a glorified Rolodex into a revenue machine. Leads are automatically enriched, scored, and routed. Follow-ups happen on autopilot.</p>
                    <ul>
                        <li><strong>Custom Pipelines</strong> - Stages that match your actual sales process</li>
                        <li><strong>Auto-Follow Up</strong> - Email & SMS sequences triggered by behavior</li>
                        <li><strong>Contract Automation</strong> - Proposals sent automatically</li>
                        <li><strong>Lead Scoring</strong> - AI-powered prioritization</li>
                    </ul>
                </div>
            </div>
            
            <div style="text-align: center; margin-top: 4rem;">
                <a href="#survey" class="cta-primary">Fix My CRM →</a>
            </div>
        </div>
    </section>

    <!-- Section 4: Analytics -->
    <section class="section" id="analytics">
        <div class="container">
            <h2 class="section-title">Data & Attribution</h2>
            
            <div class="content-row">
                <div class="visual-3d">
                    <canvas id="analyticsCanvas" width="500" height="400"></canvas>
                </div>
