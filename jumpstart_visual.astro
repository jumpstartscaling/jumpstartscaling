    <script>
        // Scroll-triggered animations
        const observerOptions = {
            threshold: 0.2,
            rootMargin: '0px 0px -100px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.content-row').forEach(row => {
            observer.observe(row);
        });

        // 3D Canvas Animations
        function draw3DShapes(canvasId, type) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                
                const time = Date.now() * 0.001;
                
                if (type === 'ads') {
                    // Rising graph with particles
                    ctx.strokeStyle = '#C9A961';
                    ctx.lineWidth = 3;
                    ctx.beginPath();
                    for (let i = 0; i < canvas.width; i += 20) {
                        const y = 300 - Math.sin(i * 0.01 + time) * 50 - (i / canvas.width) * 200;
                        if (i === 0) ctx.moveTo(i, y);
                        else ctx.lineTo(i, y);
                    }
                    ctx.stroke();
                    
                    // Floating particles
                    for (let i = 0; i < 5; i++) {
                        const x = (time * 50 + i * 100) % canvas.width;
                        const y = 200 - Math.sin(time + i) * 30;
                        ctx.fillStyle = '#E5C88D';
                        ctx.beginPath();
                        ctx.arc(x, y, 4, 0, Math.PI * 2);
                        ctx.fill();
                    }
                } else if (type === 'funnel') {
                    // 3D rotating funnel
                    const centerX = canvas.width / 2;
                    const centerY = canvas.height / 2;
                    const rotation = time * 0.5;
                    
                    ctx.save();
                    ctx.translate(centerX, centerY);
                    ctx.rotate(rotation);
                    
                    // Top ellipse
                    ctx.strokeStyle = '#C9A961';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.ellipse(0, -100, 120, 30, 0, 0, Math.PI * 2);
                    ctx.stroke();
                    
                    // Bottom ellipse
                    ctx.beginPath();
                    ctx.ellipse(0, 100, 60, 15, 0, 0, Math.PI * 2);
                    ctx.stroke();
                    
                    // Connecting lines
                    ctx.beginPath();
                    ctx.moveTo(-120, -100);
                    ctx.lineTo(-60, 100);
                    ctx.moveTo(120, -100);
                    ctx.lineTo(60, 100);
                    ctx.stroke();
                    
                    ctx.restore();
                } else if (type === 'crm') {
                    // Flowing data streams
                    for (let i = 0; i < 3; i++) {
                        const y = 100 + i * 100;
                        const progress = (time + i * 0.5) % 1;
                        const x = progress * canvas.width;
                        
                        ctx.strokeStyle = 'rgba(201, 169, 97, 0.3)';
                        ctx.lineWidth = 2;
                        ctx.beginPath();
                        ctx.moveTo(0, y);
                        ctx.lineTo(canvas.width, y);
                        ctx.stroke();
                        
                        ctx.fillStyle = '#E5C88D';
                        ctx.beginPath();
                        ctx.arc(x, y, 6, 0, Math.PI * 2);
                        ctx.fill();
                    }
                } else if (type === 'analytics') {
                    // Growing bar chart
                    const bars = [0.3, 0.5, 0.7, 0.9];
                    const barWidth = 60;
                    const spacing = 100;
                    
                    bars.forEach((height, i) => {
                        const x = 100 + i * spacing;
                        const maxHeight = 250;
                        const currentHeight = Math.min(maxHeight * height, maxHeight * height * (time % 2));
                        
                        const gradient = ctx.createLinearGradient(0, 350, 0, 350 - currentHeight);
                        gradient.addColorStop(0, '#9B7E46');
                        gradient.addColorStop(1, '#E5C88D');
                        
                        ctx.fillStyle = i === 3 ? gradient : 'rgba(255, 255, 255, 0.1)';
                        ctx.fillRect(x, 350 - currentHeight, barWidth, currentHeight);
                    });
                } else if (type === 'content') {
                    // Network distribution
                    const centerX = canvas.width / 2;
                    const centerY = canvas.height / 2;
                    
                    // Center node
                    ctx.fillStyle = '#C9A961';
                    ctx.beginPath();
                    ctx.arc(centerX, centerY, 40, 0, Math.PI * 2);
                    ctx.fill();
                    
                    // Outer nodes
                    const nodes = 6;
                    for (let i = 0; i < nodes; i++) {
                        const angle = (i / nodes) * Math.PI * 2 + time * 0.5;
                        const x = centerX + Math.cos(angle) * 150;
                        const y = centerY + Math.sin(angle) * 150;
                        
                        ctx.strokeStyle = 'rgba(201, 169, 97, 0.3)';
                        ctx.lineWidth = 2;
                        ctx.beginPath();
                        ctx.moveTo(centerX, centerY);
                        ctx.lineTo(x, y);
                        ctx.stroke();
                        
                        ctx.fillStyle = 'rgba(201, 169, 97, 0.5)';
                        ctx.beginPath();
                        ctx.arc(x, y, 25, 0, Math.PI * 2);
                        ctx.fill();
                        
                        // Traveling particles
                        const progress = (time + i * 0.3) % 1;
                        const px = centerX + (x - centerX) * progress;
                        const py = centerY + (y - centerY) * progress;
                        ctx.fillStyle = '#E5C88D';
                        ctx.beginPath();
                        ctx.arc(px, py, 4, 0, Math.PI * 2);
                        ctx.fill();
                    }
                } else if (type === 'team') {
                    // Overlapping team circles
                    const circles = [
                        { x: 180, y: 200, r: 60, alpha: 0.3 },
                        { x: 250, y: 200, r: 60, alpha: 0.5 },
                        { x: 320, y: 200, r: 60, alpha: 1 }
                    ];
                    
                    circles.forEach((circle, i) => {
                        const gradient = ctx.createRadialGradient(circle.x, circle.y, 0, circle.x, circle.y, circle.r);
                        gradient.addColorStop(0, `rgba(229, 200, 141, ${circle.alpha})`);
                        gradient.addColorStop(1, `rgba(155, 126, 70, ${circle.alpha * 0.5})`);
                        
                        ctx.fillStyle = gradient;
                        ctx.beginPath();
                        ctx.arc(circle.x, circle.y, circle.r + Math.sin(time + i) * 5, 0, Math.PI * 2);
                        ctx.fill();
                        
                        ctx.strokeStyle = '#C9A961';
                        ctx.lineWidth = 2;
                        ctx.stroke();
                    });
                }
                
                requestAnimationFrame(animate);
            }
            
            animate();
        }

        // Initialize all canvas animations
        draw3DShapes('adsCanvas', 'ads');
        draw3DShapes('funnelCanvas', 'funnel');
        draw3DShapes('crmCanvas', 'crm');
        draw3DShapes('analyticsCanvas', 'analytics');
        draw3DShapes('contentCanvas', 'content');
        draw3DShapes('teamCanvas', 'team');

        // Survey
        let currentStep = 1;
        const totalSteps = 4;

        window.nextStep = function() {
            if (currentStep < totalSteps) {
                document.querySelector(`[data-step="${currentStep}"]`).style.display = 'none';
                currentStep++;
                document.querySelector(`[data-step="${currentStep}"]`).style.display = 'block';
                document.getElementById('progressFill').style.width = `${(currentStep / totalSteps) * 100}%`;
            }
        };

        window.prevStep = function() {
            if (currentStep > 1) {
                document.querySelector(`[data-step="${currentStep}"]`).style.display = 'none';
                currentStep--;
                document.querySelector(`[data-step="${currentStep}"]`).style.display = 'block';
                document.getElementById('progressFill').style.width = `${(currentStep / totalSteps) * 100}%`;
            }
        };

        document.getElementById('surveyForm').addEventListener('submit', (e) => {
            e.preventDefault();
            document.querySelector('#surveyForm').style.display = 'none';
            document.querySelector('#successMessage').style.display = 'block';
            
            const webhooks = [
                "https://n8n.jumpstartscaling.com/webhook/2aadbf03-cff5-48b7-8236-cf344d755ed0",
                "https://n8n.jumpstartscaling.com/webhook-test/2aadbf03-cff5-48b7-8236-cf344d755ed0"
            ];
            webhooks.forEach(url => fetch(url, { method: "POST", body: new FormData(e.target) }));

            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
                "event": "form_submission",
                "formType": "scaling_survey",
                "conversionValue": 50
            });
        });

        window.addEventListener('scroll', () => {
            const sections = ['ads', 'funnels', 'crm', 'analytics', 'content', 'retainer'];
            const scrollPos = window.scrollY + 100;

            sections.forEach(id => {
                const section = document.getElementById(id);
                if (section) {
                    const sectionTop = section.offsetTop;
                    const sectionHeight = section.offsetHeight;
                    if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
                        document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
                        const activeLink = document.querySelector(`.nav-links a[href="#${id}"]`);
                        if(activeLink) activeLink.classList.add('active');
                    }
                }
            });
        });
        
        // Spotlight Effect
        const handleSpotlight = (e) => {
            const target = e.currentTarget;
            const rect = target.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            target.style.setProperty('--mouse-x', `${x}px`);
            target.style.setProperty('--mouse-y', `${y}px`);
        };
        
        document.querySelectorAll('.option-card, .nav-links a').forEach(el => {
            el.classList.add('spotlight-target');
            el.addEventListener('mousemove', handleSpotlight);
        });
    </script>

