---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Mission Control">
  <h2 class="text-xl font-bold mb-4">Mission Control</h2>
  <p class="text-gray-400 mb-6">pSEO Factory admin. Select a section from the nav.</p>
  <div class="grid grid-cols-2 md:grid-cols-5 gap-4" id="stats">
    <div class="bg-gray-900 rounded-lg p-4 border border-gray-800">
      <div class="text-3xl font-bold text-gold" id="leads-count">-</div>
      <div class="text-sm text-gray-400">Leads</div>
    </div>
    <div class="bg-gray-900 rounded-lg p-4 border border-gray-800">
      <div class="text-3xl font-bold text-gold" id="surveys-count">-</div>
      <div class="text-sm text-gray-400">Surveys</div>
    </div>
    <div class="bg-gray-900 rounded-lg p-4 border border-gray-800">
      <div class="text-3xl font-bold text-gold" id="locations-count">-</div>
      <div class="text-sm text-gray-400">Locations</div>
    </div>
    <div class="bg-gray-900 rounded-lg p-4 border border-gray-800">
      <div class="text-3xl font-bold text-gold" id="services-count">-</div>
      <div class="text-sm text-gray-400">Services</div>
    </div>
    <div class="bg-gray-900 rounded-lg p-4 border border-gray-800">
      <div class="text-3xl font-bold text-gold" id="matrix-count">-</div>
      <div class="text-sm text-gray-400">Content Matrix</div>
    </div>
  </div>
  <script>
    async function loadStats() {
      try {
        const ok = (r) => r.ok ? r.json() : Promise.reject(new Error(r.status));
        const [leads, surveys, locs, svcs, matrix] = await Promise.all([
          fetch('/api/leads').then(ok),
          fetch('/api/scaling-surveys').then(ok),
          fetch('/api/locations').then(ok),
          fetch('/api/pseo-services').then(ok),
          fetch('/api/content-matrix?limit=1000').then(ok)
        ]);
        document.getElementById('leads-count').textContent = leads?.leads?.length ?? 0;
        document.getElementById('surveys-count').textContent = surveys?.surveys?.length ?? 0;
        document.getElementById('locations-count').textContent = Array.isArray(locs) ? locs.length : 0;
        document.getElementById('services-count').textContent = Array.isArray(svcs) ? svcs.length : 0;
        document.getElementById('matrix-count').textContent = Array.isArray(matrix) ? matrix.length : 0;
      } catch (e) {
        ['leads-count','surveys-count','locations-count','services-count','matrix-count'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.textContent = '?';
        });
      }
    }
    loadStats();
  </script>
</AdminLayout>
