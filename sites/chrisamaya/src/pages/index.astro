---
// sites/chrisamaya/src/pages/index.astro
// Standalone homepage for chrisamaya.work
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import CTA from '../components/ui/CTA.astro';
import FunnelCalculator from '../components/calculators/FunnelCalculator.jsx';
import ScalingSurvey from '../components/interactivity/ScalingSurvey.tsx';

// Replicating the "Architect" content but as the MAIN index page for this site
---

<BaseLayout
  title="The One-Stop Architect | Chris Amaya"
  description="Stop hiring freelancers. Start building an empire. The 'Unicorn Developer' who builds full-stack applications, engineers private AI systems, and automates your entire backend."
  palette="emerald"
  fluid={true}
>
  <style>
    .architect-section {
      background-color: #050505;
      color: #fff;
    }
    .text-architect {
        color: #00FF94;
    }
    .border-architect {
        border-color: rgba(0,255,148,0.3);
    }
    .bg-architect-dim {
        background-color: rgba(0,255,148,0.05);
    }
    .card-custom {
        background-color: #0F0F0F;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 1rem;
        padding: 2rem;
        transition: border-color 0.3s ease;
    }
    .card-custom:hover {
        border-color: rgba(0,255,148,0.5);
    }
    .font-mono {
        font-family: 'JetBrains Mono', monospace;
    }
  </style>

  <!-- HERO -->
  <section class="min-h-screen flex items-center justify-center relative overflow-hidden pt-20">
    <div class="container mx-auto px-6 relative z-10 text-center">
        <span class="inline-block font-mono text-sm uppercase tracking-[0.2em] mb-6 px-4 py-2 rounded border border-architect bg-architect-dim text-architect">
            THE ONE-STOP ARCHITECT
        </span>
        
        <h1 class="text-5xl md:text-7xl font-black text-white mb-8 leading-tight">
            STOP GLUING YOUR BUSINESS <br class="hidden md:block" />
            TOGETHER WITH <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#00FF94] to-[#00B8FF]">ZAPIER AND HOPE.</span>
        </h1>

        <p class="text-xl md:text-2xl text-white/70 max-w-4xl mx-auto mb-12">
            I am the "Unicorn" Developer you've been looking for. I build full-stack applications, engineer private AI systems, and automate your entire backend—so you can stop playing CTO and start being the CEO.
        </p>

        <CTA label="Book Consultation" href="#contact" />
        
        <p class="font-mono text-xs text-white/50 mt-8">
            WARNING: THIS IS A TECHNICAL STRATEGY SESSION. NOT A SALES CALL.
        </p>
    </div>
  </section>

  <!-- DIAGNOSIS -->
  <section id="about" class="py-24 bg-[#08080A]">
    <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
                <span class="font-mono text-xs uppercase font-bold text-architect tracking-[0.2em] mb-4 block">THE DIAGNOSIS</span>
                <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">The "Frankenstein" Problem</h2>
                <p class="text-lg text-white/70 mb-8">
                    You have product-market fit. You have revenue. But your backend is a tangled mess of disconnected tools that break every time an API updates.
                </p>

                <div class="bg-red-900/10 border border-red-500/20 rounded-lg p-6 mb-8">
                    <h4 class="text-red-500 font-bold mb-2">⚠ SYSTEM CRITICAL</h4>
                    <p class="text-red-400/80 text-sm">
                        Your business is fragile. You are one "Zapier Error" away from losing leads.
                    </p>
                </div>
            </div>
            
            <div class="card-custom p-0 overflow-hidden border-architect/50 shadow-[0_0_30px_rgba(0,255,148,0.1)]">
                 <div class="aspect-video bg-black rounded flex items-center justify-center relative">
                    <video 
                        autoplay 
                        loop 
                        muted 
                        playsinline 
                        class="w-full h-full object-cover"
                        poster="/assets/videos/zombiebabyzaiper-poster.jpg" 
                    >
                        <source src="/assets/videos/zombiebabyzaiper.mp4" type="video/mp4">
                    </video>
                    <!-- Overlay for "FIG 1.0" label if desired, or remove -->
                    <div class="absolute bottom-4 right-4 bg-black/80 backdrop-blur px-3 py-1 rounded border border-white/10">
                        <p class="font-mono text-[10px] text-[#00FF94] tracking-widest">FIG 1.0: FRAGMENTATION VISUALIZED</p>
                    </div>
                 </div>
            </div>
        </div>
    </div>
  </section>

  <!-- CALCULATOR (Sub page brought to homepage for context) -->
  <section id="projects" class="py-24">
      <div class="container mx-auto px-6">
          <h2 class="text-3xl font-bold text-center mb-12 text-white">Engineering Resources</h2>
          <div class="max-w-4xl mx-auto glass-panel p-8 rounded-2xl border border-white/10">
               <FunnelCalculator client:visible />
          </div>
      </div>
  </section>

  <!-- SURVEY -->
  <section id="contact" class="py-24 bg-black">
      <div class="container mx-auto px-6">
          <div class="max-w-3xl mx-auto">
              <h2 class="text-3xl font-bold text-center mb-12 text-white">Let's Build It Right.</h2>
              <ScalingSurvey client:visible />
          </div>
      </div>
  </section>

</BaseLayout>