                    </ul>
                </div>
                
                <!-- Retainer -->
                <div class="service-card" style="border-color: var(--primary); background: rgba(255,107,53,0.05);">
                    <div class="service-title" style="color: var(--primary);">Comprehensive Retainer</div>
                    <div class="service-price">$5,200/week</div>
                    <div class="service-desc">Full-service marketing without limits.</div>
                    <ul class="service-list">
