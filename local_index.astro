                    <div class="service-title">HIPAA Compliance</div>
                    <div class="service-price">$1,200/setup</div>
                    <div class="service-desc">Full HIPAA compliance setup.</div>
                    <ul class="service-list">
                        <li>Audit Support</li><li>Data Security</li><li>Employee Training</li><li>Monitoring</li>
                    </ul>
                </div>
                <div class="service-card">
                    <div class="service-title">FTC Compliance</div>
                    <div class="service-price">$800/setup</div>
                    <div class="service-desc">Ensure FTC marketing compliance.</div>
                    <ul class="service-list">
