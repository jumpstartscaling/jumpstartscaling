    </section>

    <section class="testimonials">
        <div class="container">
            <h2 class="section-title">SUCCESS STORIES</h2>
            <div class="testimonial-grid">
                <div class="testimonial">
                    <p class="testimonial-text">"I went from working 80 hours a week to 30, and we doubled our revenue in 6 months."</p>
                    <p class="testimonial-author">— Sarah Jenkins, CEO</p>
                </div>
                <div class="testimonial">
                    <p class="testimonial-text">"We implemented Jumpstart and hit $5M the very next year. It felt... easy."</p>
                    <p class="testimonial-author">— Mark D., Founder</p>
                </div>
            </div>
        </div>
    </section>

    <section class="survey" id="survey">
        <div class="container">
            <h2 class="section-title">GET YOUR FREE SCALING BLUEPRINT</h2>
            <p class="section-subtitle">Customize your 90-day roadmap</p>
            
            <div class="form-container">
                <div class="progress-bar"><div class="progress-fill" id="progressFill" style="width: 14%;"></div></div>

                <form id="surveyForm">
                    <!-- Step 1: Challenge -->
                    <div class="form-step active" data-step="1">
                        <div class="form-group">
                            <label>What's your biggest challenge right now?</label>
                            <div class="radio-group">
                                <label class="radio-option"><input type="radio" name="challenge" value="lead-gen" required><span>Getting consistent leads</span></label>
                                <label class="radio-option"><input type="radio" name="challenge" value="delivery"><span>Delivering quality without me</span></label>
                                <label class="radio-option"><input type="radio" name="challenge" value="team"><span>Building/managing a team</span></label>
                                <label class="radio-option"><input type="radio" name="challenge" value="time"><span>I'm working 60+ hours/week</span></label>
                                <label class="radio-option"><input type="radio" name="challenge" value="profit"><span>Profit margins are shrinking</span></label>
                            </div>
                        </div>
                        <div class="form-buttons"><button type="button" class="btn btn-next" onclick="nextStep()">Next →</button></div>
                    </div>

                    <!-- Step 2: Revenue -->
                    <div class="form-step" data-step="2">
                        <div class="form-group">
                            <label>What's your current annual revenue?</label>
                            <div class="radio-group">
                                <label class="radio-option"><input type="radio" name="revenue" value="250k-500k" required><span>$250k - $500k</span></label>
                                <label class="radio-option"><input type="radio" name="revenue" value="500k-1m"><span>$500k - $1M</span></label>
                                <label class="radio-option"><input type="radio" name="revenue" value="1m-5m"><span>$1M - $5M</span></label>
                                <label class="radio-option"><input type="radio" name="revenue" value="5m-10m"><span>$5M - $10M</span></label>
                                <label class="radio-option"><input type="radio" name="revenue" value="10m+"><span>$10M+</span></label>
                            </div>
                        </div>
                        <div class="form-buttons">
                            <button type="button" class="btn btn-prev" onclick="prevStep()">← Back</button>
                            <button type="button" class="btn btn-next" onclick="nextStep()">Next →</button>
                        </div>
                    </div>

                    <!-- Step 3: Team Size -->
                    <div class="form-step" data-step="3">
                        <div class="form-group">
                            <label>How many people are on your team?</label>
                            <div class="radio-group">
                                <label class="radio-option"><input type="radio" name="team_size" value="solo" required><span>Just me (solo)</span></label>
                                <label class="radio-option"><input type="radio" name="team_size" value="2-5"><span>2-5 people</span></label>
                                <label class="radio-option"><input type="radio" name="team_size" value="6-10"><span>6-10 people</span></label>
                                <label class="radio-option"><input type="radio" name="team_size" value="11-25"><span>11-25 people</span></label>
                                <label class="radio-option"><input type="radio" name="team_size" value="25+"><span>25+ people</span></label>
                            </div>
                        </div>
                        <div class="form-buttons">
                            <button type="button" class="btn btn-prev" onclick="prevStep()">← Back</button>
                            <button type="button" class="btn btn-next" onclick="nextStep()">Next →</button>
                        </div>
                    </div>

                    <!-- Step 4: Services Interest -->
                    <div class="form-step" data-step="4">
                        <div class="form-group">
                            <label>What services are you most interested in? (Select all that apply)</label>
                            <div class="radio-group">
                                <label class="radio-option"><input type="checkbox" name="services" value="paid-ads"><span>Leads & Paid Ads</span></label>
                                <label class="radio-option"><input type="checkbox" name="services" value="funnels"><span>Funnels & Websites</span></label>
                                <label class="radio-option"><input type="checkbox" name="services" value="automation"><span>Automation & CRM</span></label>
                                <label class="radio-option"><input type="checkbox" name="services" value="tracking"><span>Tracking & Reporting</span></label>
                                <label class="radio-option"><input type="checkbox" name="services" value="compliance"><span>Compliance & Security</span></label>
                                <label class="radio-option"><input type="checkbox" name="services" value="full-service"><span>Full-Service Marketing</span></label>
                            </div>
                        </div>
                        <div class="form-buttons">
                            <button type="button" class="btn btn-prev" onclick="prevStep()">← Back</button>
                            <button type="button" class="btn btn-next" onclick="nextStep()">Next →</button>
                        </div>
                    </div>

                    <!-- Step 5: Ad Spend -->
                    <div class="form-step" data-step="5">
                        <div class="form-group">
                            <label>What's your current monthly ad spend?</label>
                            <div class="radio-group">
                                <label class="radio-option"><input type="radio" name="ad_spend" value="0-5k" required><span>$0 - $5k</span></label>
                                <label class="radio-option"><input type="radio" name="ad_spend" value="5k-15k"><span>$5k - $15k</span></label>
                                <label class="radio-option"><input type="radio" name="ad_spend" value="15k-50k"><span>$15k - $50k</span></label>
                                <label class="radio-option"><input type="radio" name="ad_spend" value="50k+"><span>$50k+</span></label>
                                <label class="radio-option"><input type="radio" name="ad_spend" value="none"><span>Not running ads yet</span></label>
                            </div>
                        </div>
                        <div class="form-buttons">
                            <button type="button" class="btn btn-prev" onclick="prevStep()">← Back</button>
                            <button type="button" class="btn btn-next" onclick="nextStep()">Next →</button>
                        </div>
                    </div>

                    <!-- Step 6: Industry -->
                    <div class="form-step" data-step="6">
                        <div class="form-group">
                            <label>What industry are you in?</label>
                            <select name="industry" required>
                                <option value="">Select your industry...</option>
                                <option value="marketing-agency">Marketing Agency</option>
                                <option value="saas">SaaS/Software</option>
                                <option value="ecommerce">E-commerce</option>
                                <option value="consulting">Consulting</option>
                                <option value="professional-services">Professional Services</option>
                                <option value="construction">Construction/Trades</option>
                                <option value="healthcare">Healthcare</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="form-buttons">
                            <button type="button" class="btn btn-prev" onclick="prevStep()">← Back</button>
                            <button type="button" class="btn btn-next" onclick="nextStep()">Next →</button>
                        </div>
                    </div>

                    <!-- Step 7: Contact -->
                    <div class="form-step" data-step="7">
                        <div class="form-group">
                            <label>First Name</label><input type="text" name="first_name" required placeholder="John">
                        </div>
                        <div class="form-group">
                            <label>Last Name</label><input type="text" name="last_name" required placeholder="Doe">
                        </div>
                        <div class="form-group">
                            <label>Email Address</label><input type="email" name="email" required placeholder="john@company.com">
                        </div>
                        <div class="form-group">
                            <label>Phone Number</label><input type="tel" name="phone" required placeholder="(555) 123-4567">
                        </div>
                        <div class="form-group">
                            <label>Best time to call you?</label>
                            <select name="best_time" required>
                                <option value="">Select a time...</option>
                                <option value="morning">Morning (8am-12pm)</option>
                                <option value="afternoon">Afternoon (12pm-5pm)</option>
                                <option value="evening">Evening (5pm-8pm)</option>
                            </select>
                        </div>
                        <div class="form-buttons">
                            <button type="button" class="btn btn-prev" onclick="prevStep()">← Back</button>
                            <button type="submit" class="btn btn-next">Get My Blueprint →</button>
                        </div>
                    </div>
                </form>

                <div class="success-message" id="successMessage">
                    <div class="success-icon">🎉</div>
                    <h2>Thank You!</h2>
                    <p>Your Scaling Blueprint is being prepared. We'll call you at your preferred time.</p>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <div class="trust-badges">
                <span class="badge">As Seen In: Forbes</span><span class="badge">Inc.</span>
                <span class="badge">Entrepreneur</span><span class="badge">Business Insider</span>
            </div>
            <p style="color: var(--text-muted); margin-top: 2rem;">Copyright © 2026 Jumpstart Scaling. All Rights Reserved.</p>
        </div>
    </footer>

    <script>
        let currentStep = 1;
        const totalSteps = 7;
        const n8nWebhookUrl = 'https://n8n.jumpstartscaling.com/webhook/YOUR_UNIQUE_WEBHOOK_ID'; // UPDATE THIS WHEN READY

        function updateProgress() {
            const progress = (currentStep / totalSteps) * 100;
            document.getElementById('progressFill').style.width = progress + '%';
        }

        function nextStep() {
            const currentStepEl = document.querySelector(`.form-step[data-step="${currentStep}"]`);
            const inputs = currentStepEl.querySelectorAll('input, select');
            let valid = true;
            
            // Check required fields (ignoring non-required checkbox groups if logically needed, but usually simpler here)
            // For checkboxes in step 4, we might want at least one or optional. Let's make it optional for now or check if required.
            
            inputs.forEach(input => {
                if(input.hasAttribute('required')) {
                    if (input.type === 'radio') {
                         const group = currentStepEl.querySelectorAll(`input[name="${input.name}"]`);
                         if (!Array.from(group).some(r => r.checked)) valid = false;
                    } else if (!input.value) {
                        valid = false;
                    }
                }
            });

            if (!valid) { alert('Please fill in all required fields.'); return; }

            if (currentStep < totalSteps) {
                currentStepEl.classList.remove('active');
                currentStep++;
                document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.add('active');
                updateProgress();
            }
        }

        function prevStep() {
            if (currentStep > 1) {
                document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.remove('active');
                currentStep--;
                document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.add('active');
                updateProgress();
            }
        }
        
        // Expose functions global scope
        window.nextStep = nextStep;
        window.prevStep = prevStep;

        document.getElementById('surveyForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = {};
            formData.forEach((value, key) => {
                if(!data[key]) {
                    data[key] = value;
                } else {
                    if(!Array.isArray(data[key])) data[key] = [data[key]];
                    data[key].push(value);
                }
            });

            console.log('Submission data:', data);

            // Send to n8n (Async, fire and forget for UI)
            if (n8nWebhookUrl && !n8nWebhookUrl.includes('YOUR_UNIQUE_WEBHOOK_ID')) {
                fetch(n8nWebhookUrl, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(data)
                }).catch(err => console.error('Webhook failed', err));
            } else {
                console.log('n8n webhook placeholder active - data logged to console');
            }

            this.style.display = 'none';
            document.getElementById('successMessage').classList.add('active');
        });
    </script>
</body>
</html>
