                    </ul>
                </div>
                <div class="service-card">
                    <div class="service-title">Lead Capture Funnels</div>
                    <div class="service-price">$3,500/project</div>
                    <div class="service-desc">Funnels built to optimize lead capture.</div>
                    <ul class="service-list">
                        <li>Cross-Platform</li><li>Conversion Opt</li><li>Analytics</li><li>Implementation</li>
                    </ul>
                </div>
                 <div class="service-card">
                    <div class="service-title">Membership Funnels</div>
                    <div class="service-price">$5,500/project</div>
                    <div class="service-desc">Robust community/challenge funnels.</div>
                    <ul class="service-list">
                        <li>Payment Gateways</li><li>Drip Content</li><li>Engagement Tools</li><li>Retention Strategy</li>
                    </ul>
                </div>

                <!-- Automation -->
                <div class="service-card">
                    <div class="service-title">CRM Automation Setup</div>
                    <div class="service-price">$2,500/setup</div>
                    <div class="service-desc">Custom automations for your business.</div>
                    <ul class="service-list">
                        <li>Custom Snapshots</li><li>Lead Routing</li><li>Integration Setup</li><li>Training</li>
                    </ul>
                </div>
                 <div class="service-card">
                    <div class="service-title">GoHighLevel Snapshot</div>
                    <div class="service-price">$9,997</div>
                    <div class="service-desc">Tailored setup for complete GHL mastery.</div>
                    <ul class="service-list">
                        <li>Complete CRM Setup</li><li>Adv. Automations</li><li>12-Month Support</li><li>Strategy</li>
                    </ul>
                </div>
                 <div class="service-card">
                    <div class="service-title">ClickFunnels Custom</div>
                    <div class="service-price">$9,997</div>
                    <div class="service-desc">Complete funnel solutions for CF.</div>
                    <ul class="service-list">
                        <li>Sales Funnels</li><li>12 Months Updates</li><li>Pro Copy & Design</li><li>Payment Setup</li>
                    </ul>
                </div>

                <!-- Tracking & Compliance -->
                <div class="service-card">
                    <div class="service-title">Lead Tracking</div>
                    <div class="service-price">$1,500/mo</div>
                    <div class="service-desc">Transparency on lead sources.</div>
                    <ul class="service-list">
                        <li>Attribution Models</li><li>ROI Dashboards</li><li>Call Tracking</li><li>Reporting</li>
                    </ul>
                </div>
                <div class="service-card">
                    <div class="service-title">Retargeting Ads</div>
                    <div class="service-price">$2,000/mo</div>
                    <div class="service-desc">Advanced retargeting across platforms.</div>
