---
const title = 'Jumpstart Scaling - Break Through The 7-Figure Ceiling';
const description = 'The proven methodology that helped 500+ founders automate operations, reclaim 20 hours a week, and build a valuation-ready asset in 90 days.';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #FF6B35;
            --primary-dark: #E85A2A;
            --secondary: #4ECDC4;
            --dark: #050505;
            --dark-2: #0F0F12;
            --dark-3: #1A1A20;
            --text: #ffffff;
            --text-muted: #9CA3AF;
            --accent: #FFD93D;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--dark);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        /* Interactive Background */
        #canvas-container {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -1;
            opacity: 0.4;
            pointer-events: none;
        }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 2; }
        
        /* Typography & Utilities */
        h1, h2, h3 { line-height: 1.2; letter-spacing: -0.02em; }
        .highlight {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .text-center { text-align: center; }
        .mb-4 { margin-bottom: 1rem; }
        .mb-8 { margin-bottom: 2rem; }
        
        /* Hero Section */
        .hero {
            min-height: 90vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 4rem 0;
            background: radial-gradient(circle at center, rgba(255, 107, 53, 0.05) 0%, transparent 60%);
        }
        .hero h1 {
            font-size: clamp(2.5rem, 6vw, 5rem);
            font-weight: 900;
            margin-bottom: 2rem;
            max-width: 1000px;
            animation: fadeIn 1s ease-out;
        }
        .hero .subtitle {
            font-size: clamp(1.2rem, 3vw, 1.5rem);
            color: var(--text-muted);
            max-width: 800px;
            margin-bottom: 3rem;
            animation: fadeIn 1s ease-out 0.3s backwards;
        }
        .cta-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white; padding: 1.5rem 3.5rem; font-size: 1.25rem; font-weight: 700;
            border-radius: 50px; text-decoration: none; transition: all 0.3s ease;
            box-shadow: 0 10px 40px rgba(255, 107, 53, 0.3);
            display: inline-block;
            border: 2px solid rgba(255,255,255,0.1);
        }
        .cta-primary:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 20px 60px rgba(255, 107, 53, 0.5);
        }

        /* Pillars Section */
        .section { padding: 6rem 0; border-top: 1px solid rgba(255,255,255,0.05); }
        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2.5rem; }
        
        .card {
            background: rgba(26, 26, 32, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05);
            padding: 3rem;
            border-radius: 20px;
            transition: all 0.4s ease;
        }
        .card:hover {
            border-color: var(--primary);
            transform: translateY(-10px);
            background: rgba(26, 26, 32, 0.8);
        }
        .icon-large { font-size: 3rem; margin-bottom: 1.5rem; display: block; }
        
        /* Services List */
        .service-card {
            display: flex; flex-direction: column; height: 100%;
            border-top: 4px solid transparent;
        }
        .service-card:hover { border-top-color: var(--secondary); }
        .price { font-size: 2rem; font-weight: 800; color: white; margin: 1rem 0; }
        .price-sub { font-size: 1rem; color: var(--text-muted); font-weight: 500; }
        
        /* Survey Section */
        .survey-container {
            max-width: 800px; margin: 0 auto;
            background: rgba(26, 26, 32, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            padding: 4rem;
            border: 1px solid rgba(255, 107, 53, 0.2);
            box-shadow: 0 20px 80px -20px rgba(0,0,0,0.5);
        }
        .survey-question { font-size: 1.8rem; font-weight: 700; margin-bottom: 2rem; }
        
        /* Enhanced Survey Options */
        .options-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
        .option-card {
            position: relative;
            background: rgba(0,0,0,0.3);
            border: 2px solid rgba(255,255,255,0.1);
            padding: 1.5rem 2rem;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
        }
        .option-card:hover {
            border-color: var(--secondary);
            background: rgba(78, 205, 196, 0.05);
            transform: translateX(10px);
        }
        .option-card.selected {
            border-color: var(--primary);
            background: rgba(255, 107, 53, 0.1);
        }
        .option-card input {
            appearance: none;
            width: 24px; height: 24px;
            border: 2px solid var(--text-muted);
            border-radius: 50%;
            margin-right: 1.5rem;
            position: relative;
            transition: all 0.2s;
        }
        .option-card input:checked {
            border-color: var(--primary);
            background: var(--primary);
            box-shadow: 0 0 10px rgba(255, 107, 53, 0.4);
        }
        .option-text { font-size: 1.1rem; font-weight: 500; color: white; }
        
        /* Progress Bar */
        .progress-container {
            background: rgba(255,255,255,0.1); height: 6px; border-radius: 10px;
            margin-bottom: 3rem; overflow: hidden;
        }
        .progress-bar {
            height: 100%; background: linear-gradient(90deg, var(--primary), var(--secondary));
            width: 0%; transition: width 0.4s ease;
        }

        /* FAQ Section */
        .faq-item {
            background: var(--dark-3);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 12px;
            margin-bottom: 1rem;
            overflow: hidden;
            transition: all 0.3s;
        }
        .faq-question {
            padding: 1.5rem 2rem;
            font-weight: 600;
            font-size: 1.1rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .faq-question:after { content: '+'; font-size: 1.5rem; color: var(--primary); }
        .faq-item.active .faq-question:after { content: '-'; }
        .faq-answer {
            padding: 0 2rem;
            max-height: 0;
            overflow: hidden;
            color: var(--text-muted);
            transition: all 0.3s ease;
        }
        .faq-item.active .faq-answer { padding: 0 2rem 2rem; max-height: 500px; }

        /* Animation */
        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        @media(max-width: 768px) {
            .survey-container { padding: 2rem; }
            .hero h1 { font-size: 2.5rem; }
        }
    </style>
</head>
<body>
